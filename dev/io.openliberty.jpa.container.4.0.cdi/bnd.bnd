-include= ~../cnf/resources/bnd/bundle.props

Bundle-Name: JPA 4.0 Container CDI Integration
Bundle-SymbolicName: io.openliberty.jpa.container.4.0.cdi
Bundle-Description: JPA 4.0 Container CDI Integration; version=${bVersion}

bVersion=1.0

WS-TraceGroup: JPA, CDI

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

-dsannotations: io.openliberty.jpa.container.v40.cdi.internal.JPACDIExtensionMetaData


Import-Package: \
	jakarta.persistence; version="[4.0,5)",\
	*

Private-Package: \
	io.openliberty.jpa.container.v40.cdi.internal

-buildpath: \
	com.ibm.ws.cdi.interfaces.jakarta,\
	io.openliberty.jakarta.cdi.4.1;version=latest,\
	com.ibm.websphere.appserver.spi.logging;version=latest,\
	io.openliberty.jakarta.persistence.api.4.0;version=latest,\
	com.ibm.ws.jpa.container.jakarta,\
	com.ibm.wsspi.org.osgi.service.component.annotations,\
	com.ibm.ws.org.osgi.annotation.versioning,\
	com.ibm.ws.kernel.service,\
	com.ibm.ws.cdi.internal.jakarta,\
	com.ibm.ws.container.service,\
	io.openliberty.org.eclipse.persistence-4.0,\
	io.openliberty.jakarta.transaction.2.0
