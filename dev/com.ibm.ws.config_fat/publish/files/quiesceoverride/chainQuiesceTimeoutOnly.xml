<?xml version="1.0" encoding="UTF-8"?>
<server description="Test server with only chainQuiesceTimeout">
    <featureManager>
        <feature>componenttest-1.0</feature>
        <feature>servlet-3.1</feature>
    </featureManager>

    <!-- Include fatTestPorts.xml for timedexit-1.0 feature -->
    <include location="../fatTestPorts.xml"/>

    <!-- Configure channel framework with chainQuiesceTimeout only - no quiesceTimeout on server element -->
    <channelfw chainQuiesceTimeout="20s"/>
</server>

