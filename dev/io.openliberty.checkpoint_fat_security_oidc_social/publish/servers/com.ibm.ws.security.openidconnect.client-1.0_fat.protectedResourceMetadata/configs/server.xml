<server>
    <featureManager>
        <feature>openidConnectClient-1.0</feature>
        <feature>ssl-1.0</feature>
        <feature>timedexit-1.0</feature>
        <feature>servlet-4.0</feature>
        <feature>jwt-1.0</feature>
    </featureManager>

    <httpEndpoint host="*" httpPort="${bvt.prop.security_2_HTTP_default}" httpsPort="${bvt.prop.security_2_HTTP_default.secure}" id="defaultHttpEndpoint">
        <tcpOptions soReuseAddr="true"/>
    </httpEndpoint>

    <keyStore id="defaultKeyStore" password="Liberty" />

    <ltpa keysPassword="WebAS" /> <!-- pragma: allowlist secret -->

    <!--
        Plain restore smoke test: <protectedResourceMetadata/> present at checkpoint.
        No config change between checkpoint and restore.
        Client id: oidcClientPlainRestore
    -->
    <openidConnectClient
        id="oidcClientPlainRestore"
        clientId="client01"
        clientSecret="{xor}LDo8LTorbm1saw=="
        issuerIdentifier="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample"
        authorizationEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/authorize"
        tokenEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/token"
        authFilterRef="authFilterPlainRestore">
        <protectedResourceMetadata />
    </openidConnectClient>

    <authFilter id="authFilterPlainRestore">
        <requestUrl id="requestUrlPlainRestore" urlPattern="/myApp/protectedExact" matchType="contains" />
    </authFilter>

    <!--
        Scopes change test: starts with one scope at checkpoint.
        advertisedScopes is changed to "openid,profile,email" before restore.
        Client id: oidcClientScopes
    -->
    <openidConnectClient
        id="oidcClientScopes"
        clientId="client02"
        clientSecret="{xor}LDo8LTorbm1saw=="
        issuerIdentifier="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample"
        authorizationEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/authorize"
        tokenEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/token"
        authFilterRef="authFilterScopes">
        <protectedResourceMetadata advertisedScopes="openid" />
    </openidConnectClient>

    <authFilter id="authFilterScopes">
        <requestUrl id="requestUrlScopes" urlPattern="/myApp/withScopes" matchType="contains" />
    </authFilter>

    <!--
        JWT signing test: starts with no jwtBuilderRef at checkpoint (no signing).
        jwtBuilderRef="metadataJwtBuilder" is added before restore.
        Client id: oidcClientSigning
    -->
    <openidConnectClient
        id="oidcClientSigning"
        clientId="client03"
        clientSecret="{xor}LDo8LTorbm1saw=="
        issuerIdentifier="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample"
        authorizationEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/authorize"
        tokenEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/token"
        authFilterRef="authFilterSigning">
        <protectedResourceMetadata />
    </openidConnectClient>

    <!-- JWT builder used by oidcClientSigning after restore to produce signed_metadata JWTs. -->
    <jwtBuilder id="metadataJwtBuilder" jwkEnabled="true" issuer="testIssuer" />

    <authFilter id="authFilterSigning">
        <requestUrl id="requestUrlSigning" urlPattern="/myApp/withSigning" matchType="contains" />
    </authFilter>

    <!--
        Metadata enabled test: no <protectedResourceMetadata> at checkpoint (endpoint returns 404).
        <protectedResourceMetadata/> is added before restore (endpoint returns 200).
        Client id: oidcClientMetadataEnabled
    -->
    <openidConnectClient
        id="oidcClientMetadataEnabled"
        clientId="client04"
        clientSecret="{xor}LDo8LTorbm1saw=="
        issuerIdentifier="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample"
        authorizationEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/authorize"
        tokenEndpointUrl="http://localhost:${bvt.prop.security_2_HTTP_default}/oidc/endpoint/OidcConfigSample/token"
        authFilterRef="authFilterMetadataEnabled">
    </openidConnectClient>

    <authFilter id="authFilterMetadataEnabled">
        <requestUrl id="requestUrlMetadataEnabled" urlPattern="/myApp/metadataEnabled" matchType="contains" />
    </authFilter>

</server>
