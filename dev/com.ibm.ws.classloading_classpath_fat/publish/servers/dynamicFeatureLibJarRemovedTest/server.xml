<server>
    <featureManager>
        <feature>servlet-4.0</feature>
        <feature>componenttest-1.0</feature>
        <feature>testFeatureApi-1.0</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

    <!--
        The shared library JAR contains the library-removal implementation classes, which implement
        TestFeatureApi from the feature bundle. The library classloader is cached in
        ClassLoadingServiceImpl.aclStore under the "testFeatureSharedLib" key.

        Unlike dynamicFeatureSharedLibTest (Test 2), this server.xml IS modified
        during the test. The FAT class swaps to server_no_lib.xml for State 2, which
        removes the JAR from the fileset and triggers SharedLibraryImpl.delete(),
        evicting the library AppClassLoader from aclStore. The original server.xml is
        restored for State 3.
    -->
    <library id="testFeatureSharedLib">
        <fileset dir="${server.config.dir}/sharedLibs" includes="testSharedFeatureLib.jar"/>
    </library>

    <webApplication location="testDynamicFeatureLibJarRemovedApp.war">
        <classloader commonLibraryRef="testFeatureSharedLib"/>
    </webApplication>

    <!--
        getClassLoader permission is required by the probe servlet to log classloader
        identity strings for architectural analysis.
    -->
    <javaPermission
        codeBase="${server.config.dir}/apps/testDynamicFeatureLibJarRemovedApp.war"
        className="java.lang.RuntimePermission"
        name="getClassLoader"/>
    <javaPermission
        codeBase="${server.config.dir}/sharedLibs/testSharedFeatureLib.jar"
        className="java.lang.RuntimePermission"
        name="getClassLoader"/>
</server>
