<server>
    <featureManager>
        <feature>servlet-4.0</feature>
        <feature>componenttest-1.0</feature>
        <feature>testLibraryUser-1.0</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

    <webApplication location="testLibraryUser.war">
        <classloader commonLibraryRef="testCommonLib" />
    </webApplication>

    <library id="testCommonLib">
    <!--
        <fileset dir="${server.config.dir}/libs" includes="*.jar" scanInterval="0s" />
        -->
       <!-- test of relative path to jar -->
       <path name="libs/testLib1.jar"/>
       <!-- test of absolute path to jar -->
       <path name="libs/testLib2.jar"/>
       <!-- test of relative path to dir -->
       <path name="libs/testLib3.jar"/>
       <!-- test of absolute path to dir -->
       <path name="libs/testLib4.jar"/>
    </library>

    <javaPermission codeBase="${server.config.dir}/apps/testLibraryUser.war" className="java.lang.RuntimePermission" name="getClassLoader"/>
    <javaPermission codeBase="${server.config.dir}/apps/testLibraryUser.war" className="java.util.PropertyPermission" name="*" actions="read,write"/>
</server>

