<server>
    <featureManager>
        <feature>servlet-4.0</feature>
        <feature>componenttest-1.0</feature>
        <feature>testFeatureApi-1.0</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

    <!--
        Identical to server.xml except for the <classloader> element below. Adding it is a
        config-only change to the application that does not touch the feature set, so it
        restarts the application through the ordinary config-update route (State 1.5).
        delegation="parentFirst" is the default, so effective class loading is unchanged.
    -->
    <webApplication location="testDynamicFeatureApp.war">
        <classloader delegation="parentFirst"/>
    </webApplication>

    <!-- Does not reference the feature API; must not be restarted when the feature is removed. -->
    <webApplication location="testUnrelatedFeatureApp.war"/>

    <javaPermission
        codeBase="${server.config.dir}/apps/testDynamicFeatureApp.war"
        className="java.lang.RuntimePermission"
        name="getClassLoader"/>
</server>
