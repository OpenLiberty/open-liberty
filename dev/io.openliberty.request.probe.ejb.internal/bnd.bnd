-include= ~../cnf/resources/bnd/bundle.props

bVersion=1.0

Bundle-Name: Request Probe EJB
Bundle-SymbolicName: io.openliberty.request.probe.ejb.internal
Bundle-Description: RequestProbeEJB: Request Probe EJB; version=${bVersion}

WS-TraceGroup: io.openliberty.request.probe.ejb.internal

Import-Package: \
    com.ibm.websphere.ras, \
    com.ibm.wsspi.request.probe.bci, \
    com.ibm.wsspi.requestContext, \
    com.ibm.ws.ejbcontainer, \
    com.ibm.ejs.container

Private-Package: io.openliberty.request.probe.ejb.internal

-dsannotations: \
    io.openliberty.request.probe.ejb.internal.EJBAsyncTransformDescriptor, \
    io.openliberty.request.probe.ejb.internal.EJBMessageEndpointTransformDescriptor, \
    io.openliberty.request.probe.ejb.internal.EJBRemoteTransformDescriptor, \
    io.openliberty.request.probe.ejb.internal.EJBRequestTimingCollaboratorImpl, \
    io.openliberty.request.probe.ejb.internal.EJBTimerTransformDescriptor

instrument.disabled: true

-buildpath: \
    com.ibm.ws.logging.core;version=latest, \
    com.ibm.wsspi.org.osgi.service.component.annotations;version=latest, \
    com.ibm.ws.request.probes;version=latest, \
    com.ibm.ws.ejbcontainer;version=latest, \
    com.ibm.ws.ejbcontainer.core;version=latest, \
    com.ibm.ws.container.service.compat;version=latest
