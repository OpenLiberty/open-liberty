<server>
	<featureManager>
		<feature>usr:wsseccbh-1.0</feature>
		<feature>ssl-1.0</feature>
		<feature>usr:wsseccbh-1.0</feature>
		<feature>appSecurity-2.0</feature>
		<feature>servlet-3.1</feature>
		<feature>jaxws-2.2</feature>
		<feature>wsSecurity-1.1</feature>
		<feature>jsp-2.3</feature>
	</featureManager>

	<include location="../fatTestPorts.xml"/>

	<basicRegistry id="basic" realm="customRealm">
		<user name="user1" password="security" />
		<user name="user2" password="security" />
		<user name="test1" password="security" />
		<user name="test2" password="security" />
		<user name="test3" password="security" />
		<user name="test4" password="security" />
		<user name="admin" password="admin" />
		<user name="bob" password="bob" />
		<user name="joe" password="joe" />

		<group name="group1">
			<member name="user1" />
			<member name="user2" />
		</group>
	</basicRegistry>

	<!-- ##for testing with SSL/https between WebSphere and Liberty ##You may
		want to copy the key.p12 and trust.p12 from WebSphere configuration over
		##here and using these settings for a quick test. <keyStore id="myKeyStore"
		password="WebAS" type="PKCS12" location="${server.config.dir}/key.p12" />
		<keyStore id="myTrustStore" password="WebAS" type="PKCS12" location="${server.config.dir}/trust.p12"
		/> -->

	<keyStore id="myKeyStore" password="Liberty" type="jks"
		location="${server.config.dir}/key.jks" />
	<keyStore id="myTrustStore" password="LibertyServer" type="jks"
		location="${server.config.dir}/sslServerTrust.jks" />

	<ssl id="defaultSSLConfig" keyStoreRef="myKeyStore"
		trustStoreRef="myTrustStore" />

	<webApplication id="WSSampleSei" location="WSSampleSei.war"
		name="WSSampleSei">
		<application-bnd>
			<security-role name="group1">
				<group name="group1" />
			</security-role>
		</application-bnd>
	</webApplication>

	<webApplication id="webcontentprovider" location="webcontentprovider.war"
		name="webcontentprovider">
		<application-bnd>
			<security-role name="group1">
				<group name="group1" />
			</security-role>
		</application-bnd>
	</webApplication>

	<webApplication id="WSSampleSeiClient" location="WSSampleSeiClient.war"
		name="WSSampleSeiClient">
		<application-bnd>
			<security-role name="group1">
				<group name="group1" />
			</security-role>
		</application-bnd>
	</webApplication>

	<webApplication id="webcontent" location="webcontent.war"
		name="webcontent">
		<application-bnd>
			<security-role name="group1">
				<group name="group1" />
			</security-role>
		</application-bnd>
	</webApplication>

	<javaPermission className="java.security.AllPermission"
		name="*" actions="*" />

	<wsSecurityProvider id="default" ws-security.callback-handler="com.ibm.ws.wssecurity.example.cbh.CommonPasswordCallback">
		<signatureProperties
			signatureAlgorithm="sha256"
			org.apache.ws.security.crypto.merlin.keystore.type="PKCS12"
			org.apache.ws.security.crypto.merlin.keystore.password="sampleapp"
			org.apache.ws.security.crypto.merlin.keystore.alias="bob"
			org.apache.ws.security.crypto.merlin.file="${server.config.dir}/receiver.p12" />
		<encryptionProperties
			org.apache.ws.security.crypto.merlin.keystore.type="PKCS12"
			org.apache.ws.security.crypto.merlin.keystore.password="sampleapp"
			org.apache.ws.security.crypto.merlin.keystore.alias="alice"
			org.apache.ws.security.crypto.merlin.file="${server.config.dir}/sender.p12" />
	</wsSecurityProvider>

	<!-- provide WebServiceClient user-ID and password -->
	<wsSecurityClient
		id="default"
		ws-security.password="security"
		ws-security.username="user1"
		ws-security.callback-handler="com.ibm.ws.wssecurity.example.cbh.CommonPasswordCallback"
	>
	        <!--issue 30353 -->
		<signatureProperties
                        signatureAlgorithm="sha256"
			org.apache.ws.security.crypto.merlin.keystore.type="PKCS12"
			org.apache.ws.security.crypto.merlin.keystore.password="sampleapp"
			org.apache.ws.security.crypto.merlin.keystore.alias="alice"
			org.apache.ws.security.crypto.merlin.file="${server.config.dir}/sender.p12" />
		<encryptionProperties
			org.apache.ws.security.crypto.merlin.keystore.type="PKCS12"
			org.apache.ws.security.crypto.merlin.keystore.password="sampleapp"
			org.apache.ws.security.crypto.merlin.keystore.alias="bob"
			org.apache.ws.security.crypto.merlin.file="${server.config.dir}/receiver.p12" />
	</wsSecurityClient>

</server>
