<server>
    <featureManager>
        <feature>openidConnectClient-1.0</feature>
        <feature>ssl-1.0</feature>
    </featureManager>

    <!-- Port configuration copied from common project during the build. -->
    <include location="imports/fatTestPorts.xml" />

    <!-- Minimal SSL config to satisfy the mandatory SSLSupport reference in OidcClientConfigImpl.
         The metadata endpoint is served over HTTP so no real keystore is needed. -->
    <keyStore id="defaultKeyStore" password="Liberty" />

    <!--
        OIDC client with an equals auth filter — tests that an exact path match
        returns metadata for that resource.
    -->
    <openidConnectClient
        id="OidcConfigSample"
        clientId="client01"
        clientSecret="{xor}LDo8LTorbm1saw=="
        issuerIdentifier="http://localhost:${bvt.prop.HTTP_default}/oidc/endpoint/OidcConfigSample"
        authorizationEndpointUrl="http://localhost:${bvt.prop.HTTP_default}/oidc/endpoint/OidcConfigSample/authorize"
        tokenEndpointUrl="http://localhost:${bvt.prop.HTTP_default}/oidc/endpoint/OidcConfigSample/token"
        authFilterRef="authFilter1"
    />

    <!--
        Second OIDC client with a contains auth filter — tests that a sub-path
        of the pattern (e.g. /myApp/protected/subPath) also returns metadata.
    -->
    <openidConnectClient
        id="OidcConfigSampleContains"
        clientId="client02"
        clientSecret="{xor}LDo8LTorbm1saw=="
        issuerIdentifier="http://localhost:${bvt.prop.HTTP_default}/oidc/endpoint/OidcConfigSample"
        authorizationEndpointUrl="http://localhost:${bvt.prop.HTTP_default}/oidc/endpoint/OidcConfigSample/authorize"
        tokenEndpointUrl="http://localhost:${bvt.prop.HTTP_default}/oidc/endpoint/OidcConfigSample/token"
        authFilterRef="authFilter2"
    />

    <!--
        authFilter1: exact match on the full URL — only /myApp/protected returns metadata,
        not sub-paths like /myApp/protected/subPath.
    -->
    <authFilter id="authFilter1">
        <requestUrl
            id="requestUrl1"
            urlPattern="http://localhost:${bvt.prop.HTTP_default}/myApp/protected"
            matchType="equals" />
    </authFilter>

    <!--
        authFilter2: sub-string match — /myApp/protected/subPath also returns metadata
        because the URL contains the pattern.
    -->
    <authFilter id="authFilter2">
        <requestUrl
            id="requestUrl2"
            urlPattern="/myApp/protected"
            matchType="contains" />
    </authFilter>

</server>
