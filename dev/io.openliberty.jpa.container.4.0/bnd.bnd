-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: JPA 4.0 Container Runtime
Bundle-SymbolicName: io.openliberty.jpa.container.4.0
Bundle-Description: JPA 4.0 Container Runtime; version=${bVersion}

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

WS-TraceGroup: JPA

-dsannotations: \
  io.openliberty.jpa.container.v40.JPAPCtxtAttributeAccessorV40, \
  io.openliberty.jpa.container.v40.internal.JPA40Runtime

Import-Package: \
  jakarta.persistence;jpa="4.0";consumer="persistenceService", \
  jakarta.persistence.criteria;jpa="4.0";consumer="persistenceService", \
  jakarta.persistence.sql;jpa="4.0";consumer="persistenceService", \
  *

Private-Package: \
  io.openliberty.jpa.container.v40.*

-buildpath: \
	com.ibm.ws.jpa.container.jakarta;version=latest,\
	io.openliberty.jakarta.persistence.4.0;version=latest,\
	com.ibm.wsspi.org.osgi.core;version=latest,\
	com.ibm.wsspi.org.osgi.service.component.annotations;version=latest,\
	com.ibm.tx.jta.jakarta;version=latest,\
	com.ibm.ws.logging.core;version=latest,\
	com.ibm.ws.container.service;version=latest,\
	io.openliberty.jakarta.transaction.2.0;version=latest
