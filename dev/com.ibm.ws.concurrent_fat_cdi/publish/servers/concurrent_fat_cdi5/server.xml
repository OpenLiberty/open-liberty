<server>
    <featureManager>
        <feature>cdi-5.0</feature>
        <feature>componenttest-2.0</feature>
        <feature>concurrent-3.2</feature>
        <feature>connectors-2.2</feature>
        <feature>enterpriseBeansLite-4.0</feature>
        <feature>jndi-1.0</feature>
        <feature>servlet-6.2</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

    <application location="concurrentCDI4_1App.ear">
        <classloader commonLibraryRef="location-context,concurrentCDI4_1Shared"/>
    </application>
    
    <ejbApplication location="concurrentCDI4_1EJBStandalone.jar">
        <classloader commonLibraryRef="concurrentCDI4_1Shared"/>
    </ejbApplication>
    
    <resourceAdapter location="${server.config.dir}connectors/concurrentCDI4_1RAR.rar"
                     autoStart="true">
    </resourceAdapter>

    <!-- fake third-party context provider -->
    <library id="location-context">
        <file name="${server.config.dir}/lib/location-context.jar"/>
    </library>
    
    <!-- Shared interface for standalone EJB -->
    <library id="concurrentCDI4_1Shared">
        <file name="${server.config.dir}/lib/concurrentCDI4_1Shared.jar"/>
    </library>

    <managedExecutorService jndiName="concurrent/sampleExecutor">
        <concurrencyPolicy max="2" maxQueueSize="2"/>
    </managedExecutorService>

    <managedScheduledExecutorService jndiName="concurrent/timeoutExecutor">
        <concurrencyPolicy max="1" maxQueueSize="1" maxWaitForEnqueue="1m" startTimeout="3s"/>
    </managedScheduledExecutorService>

    <!-- needed to shut down pool of unmanaged threads that is used by the application -->
    <javaPermission codebase="${server.config.dir}/dropins/concurrentCDI4_1App.war"
                    className="java.lang.RuntimePermission" name="modifyThread"/>
    <javaPermission codebase="${server.config.dir}/dropins/concurrentCDI4App.war"
                    className="java.lang.RuntimePermission" name="modifyThread"/>

</server>