<server description="EJB request probe registration test server">

    <!-- eventLogging-1.0 is the baseline probe feature.  EJB/MDB features are added and removed
         programmatically by each test. -->
    <featureManager>
        <feature>eventLogging-1.0</feature>
    </featureManager>

    <eventLogging includeContextInfo="true" minDuration="0" eventTypes="all"/>

    <include location="../fatTestPorts.xml"/>

</server>
