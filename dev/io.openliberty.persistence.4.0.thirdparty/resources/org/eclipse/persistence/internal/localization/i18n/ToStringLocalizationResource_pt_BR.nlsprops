sdo_classgenerator_usage_help_1of8={0} Uso: org.eclipse.persistence.sdo.helper.{0} [-options]

sdo_classgenerator_usage_help_2of8=Opções:

sdo_classgenerator_usage_help_3of8=-help Imprime o texto da mensagem de ajuda

sdo_classgenerator_usage_help_4of8=-sourceFile <FileName> O arquivo de esquema de entrada (obrigatório)

sdo_classgenerator_usage_help_5of8=-targetDirectory <DirName> O diretório para gerar a origem Java (opcional)

sdo_classgenerator_usage_help_6of8=-logLevel <level int> Especifique o valor inteiro do nível de criação de log (8=OFF,7=GRAVE,6=AVISO,5=INFO,4=CONFIG,3=FINO,2=FINER(padrão),1=FINEST,0=ALL).

sdo_classgenerator_usage_help_7of8=-noInterfaces Não gera classes de interface

sdo_classgenerator_usage_help_8of8=-noImpls Não gera classes de impl

sdo_classgenerator_usage_missing_sourcefile={0} O parâmetro -sourceFile não foi especificado e é obrigatório.

sdo_classgenerator_usage_missing_sourcefile_value={0} O valor de -sourceFile não foi especificado.

sdo_classgenerator_usage_missing_targetdir={0} O valor de -targetDirectory não foi especificado.

server_name=nome do servidor

shortestTime=tempo mais curto

staticweave_commandline_help_message_10of19=-log

staticweave_commandline_help_message_11of19=Especifique o arquivo de criação de log.

staticweave_commandline_help_message_12of19=-loglevel

staticweave_commandline_help_message_13of19=Especifique o valor inteiro do nível de criação de log (8=OFF,7=SEVERE,6=WARNING,5=INFO,4=CONFIG,3=FINE,2=FINER(default),1=FINEST,0=ALL).

staticweave_commandline_help_message_14of19=O caminho de classe deve conter todas as classes necessárias para carregar as classes na origem.

staticweave_commandline_help_message_15of19=O weaving será executado no lugar se a origem e o destino apontam para o mesmo local.  Weaving no local será aplicável APENAS para origens baseadas em diretório.

staticweave_commandline_help_message_16of19=Exemplo:

staticweave_commandline_help_message_17of19=Para entrelaçar todas as entidades contidas no C:oo-source.jar com seu persistence.xml contido dentro do C:oo-containing-persistence-xml.jar,

staticweave_commandline_help_message_18of19=e saída para C:oo-target.jar:

staticweave_commandline_help_message_19of19=StaticWeave -persistenceinfo C:oo-containing-persistence-xml.jar -classpath C:classpath1;C:classpath2 C:oo-source.jar C:oo-target.jar

staticweave_commandline_help_message_1of19=Uso: StaticWeave [opções] a origem de destino

staticweave_commandline_help_message_2of19=Opções:

staticweave_commandline_help_message_3of19=caminho de classe -classpath

staticweave_commandline_help_message_4of19=Configure o caminho de classe do usuário.  Use ";" como um delimitador no Windows e ":" no Unix.

staticweave_commandline_help_message_5of19=-persistenceinfo

staticweave_commandline_help_message_6of19=Identifique explicitamente onde META-INF/persistence.xml está armazenado.  Ele deve ser a raiz de META-INF/persistence.xml.

staticweave_commandline_help_message_7of19=Esta opção geralmente é usada para especificar o jar principal quando trançar arquivos referenciados por <jar-file> no arquivo persistence.xml.

staticweave_commandline_help_message_8of19=-persistencexml

staticweave_commandline_help_message_9of19=Identifique o local do persistence.xml relativo à raiz da unidade de persistência se estiver em algum outro lugar além de META-INF/persistence.xml

staticweave_processor_dir_not_created=O diretório {0} não pode ser criado.

staticweave_processor_file_not_created=O arquivo {0} não pode ser criado.

staticweave_processor_unknown_outcome=O entrelaçamento de classes armazenadas em um diretório e a saída para um JAR muitas vezes leva a resultados inesperados.

time_object=tempo/objeto

total_time=tempo total

