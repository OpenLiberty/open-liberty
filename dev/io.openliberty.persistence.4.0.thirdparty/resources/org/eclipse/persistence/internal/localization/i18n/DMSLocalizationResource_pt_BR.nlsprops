# # {0} description of each insert field
# MSG_DESCRIPTIVE_NAME_CWSJX0000=CWSJX0000I: This is a message with inserts {0}
# MSG_DESCRIPTIVE_NAME_CWSJX0000.explanation=Explanation text for the message
# MSG_DESCRIPTIVE_NAME_CWSJX0000.useraction=User action text for the message
#
#CMVCPATHNAME org/eclipse/persistence/internal/localization/i18n/DMSLocalizationResource_pt_BR.nlsprops
#COMPONENTPREFIX None
#COMPONENTNAMEFOR None - generated from open source project
#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
# NLS_MESSAGEFORMAT_ALL
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 
#
# -------------------------------------------------------------------------------------------------
assigning_sequence_numbers=Inclui o tempo gasto na manutenção do mecanismo de número de sequência e na definição do número de sequência em objetos

cache_hits=O número de vezes que o objeto foi localizado no cache

cache_misses=O número de vezes que o objeto não foi localizado no cache

caching=Inclui tempo gasto incluindo, procurando e removendo objetos no cache

change_set_not_processed=O número de ObjectChangeSets descartados porque o objeto NÃO foi localizado no cache

change_set_processed=O número de ObjectChangeSets que foram localizados no cache

client_session_count=O número de ClientSession registradas em

connect_call=Número total de chamadas de conexão feitas

connection=Tempo gasto gerenciando conexões incluindo conectar, reconectar, e desconectar a partir de uma origem de dados

connection_in_used=Número de conexões em uso por conjunto para qualquer ConnectionPool exclusivo (Write, ExclusiveRead)

connection_ping=Tempo gasto testando a conexão do banco de dados para determinar se ele pode ser usado.

database_execute=Tempo gasto em chamadas para a Instrução JDBC, inclui o tempo gasto em chamadas para: fechar, executeUpdate, e executeQuery

deleted_object=O objeto precisar ser removido de identityMap de ObjectChangeSet

descriptor_event=Tempo gasto ao executar DescriptorEvent

disconnect_call=Número total de chamadas de desconexão feitas

distributed_merge=Tempo gasto mesclando alterações de transação remota para o cache local compartilhado. Aparece quando sincronização de cache é usada

jts_aftercompletion=Tempo gasto no método JTS afterCompletion(Object status)

jts_beforecompletion=Tempo gasto no método beforeCompletion JTS ()

logging=Tempo gasto nas atividades de criação de log TopLink

merge_time=Tempo gasto mesclando alterações no cache compartilhado.

object_building=Tempo gasto construindo objetos persistentes a partir de linhas do banco de dados

optimistic_lock=Número de exceções de bloqueio otimista que foram lançadas

query=Tempo total gasto na operação: {0}

query_misc=Tempo total gasto na operação: {0}.  Isto é para operações especiais não incluídas em quaisquer nomes de consulta, como a gravação em lote.

query_prepareation=Tempo para preparar a consulta

rcm_message_received=Número de mensagens que foram recebidas por meio de RCM

rcm_message_sent=O número de mensagens que foram enviadas por meio de RCM

rcm_status=Uma de [não configuradas, iniciadas, paradas]

remote_change_set=Número de conjuntos de mudanças recebidos a partir de máquinas remotas e processados

row_fetch=Tempo gasto para construir objetos de Registro a partir do ResultSet jdbc. Inclui chamadas SQL regulares e chamadas de procedimento armazenado

session_event=Tempo gasto na execução do SessionEvent

session_login_time=Tempo de log in da sessão

session_name=O nome da sessão

sql_generation=Tempo gasto gerando SQL. No caso de expressões TopLink, o tempo gasto para converter a Expressão para SQL

sql_prepare=Tempo gasto no JDBC preparando a Instrução. Também inclui o tempo gasto no EIS criando uma Interação associada a uma conexão, e a criação de objetos de Registro de entrada e saída

unitofwork_commit=Mede o processo de confirmação do UnitOfWork

unitofwork_commits=Número de confirmações UnitOfWork

unitofwork_count=Contagem de número total de objetos UnitOfWork criados

unitofwork_register=Inclui tempo gasto em registerExistingObject, registerNewContainerBean, registerNewContainerBeanForCMP, registerNewObject, registerObject, readIntoWorkingCopy)

unitofwork_rollback=Número de confirmações UnitOfWork que foram retrocedidas

wrapping=Tempo gasto agrupando ambos os beans CMP e BMP

