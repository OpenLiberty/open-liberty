sdo_classgenerator_usage_help_1of8={0} Składnia: org.eclipse.persistence.sdo.helper.{0} [-opcje]

sdo_classgenerator_usage_help_2of8=Opcje:

sdo_classgenerator_usage_help_3of8=-help                        Wyświetla tekst komunikatu pomocy

sdo_classgenerator_usage_help_4of8=-sourceFile <nazwa_pliku> Wejściowy plik schematu (wymagany)

sdo_classgenerator_usage_help_5of8=-targetDirectory <DirName>   Katalog, w którym zostanie wygenerowane źródło Java (opcjonalny)

sdo_classgenerator_usage_help_6of8=-logLevel <poziom>  Podaj liczbę całkowitą określającą poziom rejestrowania (8=WYŁ., 7=POWAŻNY, 6=OSTRZEŻENIE, 5=INFORMACJA, 4=KONFIGURACJA, 3=DOKŁADNY, 2=DOKŁADNIEJ (domyślny), 1=NAJDOKŁADNIEJ, 0=WSZYSTKO).

sdo_classgenerator_usage_help_7of8=-noInterfaces                Nie generuj klas interfejsu

sdo_classgenerator_usage_help_8of8=-noImpls                     Nie generuj klas implementacji

sdo_classgenerator_usage_missing_sourcefile={0} Parametr -sourceFile nie został podany, a jest wymagany.

sdo_classgenerator_usage_missing_sourcefile_value={0} Nie podano wartości parametru -sourceFile.

sdo_classgenerator_usage_missing_targetdir={0} Nie podano wartości parametru -targetDirectory.

server_name=nazwa serwera

shortestTime=najkrótszy czas

staticweave_commandline_help_message_10of19=-log

staticweave_commandline_help_message_11of19=Określ plik rejestrowania.

staticweave_commandline_help_message_12of19=-loglevel

staticweave_commandline_help_message_13of19=Podaj liczbę całkowitą określającą poziom rejestrowania (8=WYŁ., 7=POWAŻNY, 6=OSTRZEŻENIE, 5=INFORMACJA, 4=KONFIGURACJA, 3=DOKŁADNY, 2=DOKŁADNIEJ (domyślny), 1=NAJDOKŁADNIEJ, 0=WSZYSTKO).

staticweave_commandline_help_message_14of19=Ścieżka klas musi zawierać wszystkie klasy wymagane do ładowania klas w źródle.

staticweave_commandline_help_message_15of19=Jeśli źródło i cel wskazują na to samo położenie, manipulowanie kodem bajtowym zostanie przeprowadzone na miejscu.  Manipulowanie kodem bajtowym na miejscu ma zastosowanie TYLKO dla źródeł opartych na katalogach.

staticweave_commandline_help_message_16of19=Przykład:

staticweave_commandline_help_message_17of19=Aby manipulować kodem bajtowym wszystkich jednostek zawartych w pliku C:oo-source.jar z użyciem pliku persistence.xml zawartego w pliku C:oo-containing-persistence-xml.jar,

staticweave_commandline_help_message_18of19=a dane wyjściowe zapisać w pliku C:oo-target.jar:

staticweave_commandline_help_message_19of19=StaticWeave -persistenceinfo C:oo-containing-persistence-xml.jar -classpath C:classpath1;C:classpath2 C:oo-source.jar C:oo-target.jar

staticweave_commandline_help_message_1of19=Składnia: StaticWeave [opcje] źródło cel

staticweave_commandline_help_message_2of19=Opcje:

staticweave_commandline_help_message_3of19=-classpath ścieżka klas

staticweave_commandline_help_message_4of19=Ustaw ścieżkę klas użytkownika.  Użyj średnika (;) jako separatora w systemie Windows, a dwukropka (:) w systemie Unix.

staticweave_commandline_help_message_5of19=-persistenceinfo

staticweave_commandline_help_message_6of19=Określ jawnie miejsce przechowywania pliku META-INF/persistence.xml.  Musi to być katalog główny dla pliku META-INF/persistence.xml.

staticweave_commandline_help_message_7of19=Ta opcja jest zazwyczaj używana do określania głównego archiwum jar podczas manipulowania kodem bajtowym plików przywoływanych przez wartość parametru <jar-file> w pliku persistence.xml.

staticweave_commandline_help_message_8of19=-persistencexml

staticweave_commandline_help_message_9of19=Określ położenie pliku persistence.xml względem katalogu głównego jednostki trwałości, jeśli ten plik nie znajduje się w ścieżce META-INF/persistence.xml

staticweave_processor_dir_not_created=Nie można utworzyć katalogu {0}.

staticweave_processor_file_not_created=Nie można utworzyć pliku {0}.

staticweave_processor_unknown_outcome=Manipulowanie kodem bajtowym klas przechowywanych w katalogu i wyprowadzanie ich do pliku JAR często prowadzi do nieoczekiwanych wyników.

time_object=czas/obiekt

total_time=łączny czas

unknown=nieznany

user_name=nazwa użytkownika

writer=program piszący

