assigning_sequence_numbers=Zahrnuje čas strávený údržbou mechanizmu pořadových čísel a skutečným nastavením pořadových čísel u objektů

cache_hits=Kolikrát byl objekt nalezen v mezipaměti

cache_misses=Kolikrát nebyl objekt nalezen v mezipaměti

caching=Zahrnuje čas strávený přidáváním, vyhledáváním a odebíráním objektů z mezipaměti

change_set_not_processed=Počet vyhozených objektů ObjectChangeSets, protože tento objekt NEBYL nalezen v mezipaměti

change_set_processed=Počet objektů ObjectChangeSets nalezených v mezipaměti

client_session_count=Počet přihlášených relací ClientSession

connect_call=Celkový počet provedených volání připojení

connection=Čas strávený správnou připojení, včetně připojení, opětovného připojení a odpojení od zdroje dat

connection_in_used=Počet používaných připojení pro daný fond pro všechny výlučné operace ConnectionPool(Write, ExclusiveRead)

connection_ping=Čas strávený testováním databázového připojení k určení, zda ho lze použít.

database_execute=Čas strávený ve volání příkazů JDBC, zahrnuje čas strávený voláními: close, executeUpdate a executeQuery

deleted_object=Objekt je třeba odebrat z mapy identityMap ze sady ObjectChangeSet

descriptor_event=Čas strávený provedením události DescriptorEvent

disconnect_call=Celkový počet provedených volání odpojení

distributed_merge=Čas strávený slučováním změn vzdálených transakcí do lokální sdílené mezipaměti. Objevuje se, když se používá synchronizace mezipaměti.

jts_aftercompletion=Čas strávený metodou JTS afterCompletion(Object status)

jts_beforecompletion=Čas strávený metodou JTS beforeCompletion()

logging=Čas strávený protokolování aktivit TopLink

merge_time=Čas strávený slučováním změn do sdílené mezipaměti

object_building=Čas strávený sestavováním trvalých objektů z databázových řádků

optimistic_lock=Počet vydaných výjimek zamykání před aktualizací

query=Celkový čas strávený v operaci: {0}

query_misc=Celkový čas strávený v operaci: {0}. Tato hodnota je určena pro speciální operace, které nejsou součástí žádných dotazových slov, jako jsou např. zápisy do vyrovnávací paměti.

query_prepareation=Čas na přípravu dotazu

rcm_message_received=Počet zpráv přijatých prostřednictvím RCM

rcm_message_sent=Počet zpráv odeslaných prostřednictvím RCM

rcm_status=Jedno z [nekonfigurováno, spuštěno, zastaveno]

remote_change_set=Počet sad změn přijatých ze vzdálených počítačů a zpracovaných

row_fetch=Čas strávený sestavením objektů typu Záznam ze sady výsledků JDBC. Zahrnuje regulární volání SQL a volání uložených procedur.

session_event=Čas strávený provedením události SessionEvent

session_login_time=Čas, po kterou byla relace přihlášená

session_name=Název relace

sql_generation=Čas strávený generováním SQL. V případě výrazů TopLink to je čas strávený převodem výrazu na SQL.

sql_prepare=Čas strávený v JDBC přípravou příkazu. Zahrnuje také čas strávený v EIS vytvářením interakce přidružené k připojení a vytvářením vstupního a výstupního objektu typu Záznam.

unitofwork_commit=Měří proces potvrzení objektů UnitOfWork

unitofwork_commits=Počet potvrzení objektů UnitOfWork

unitofwork_count=Počítá celkový počet vytvořených objektů UnitOfWork

unitofwork_register=Zahrnuje čas strávený v metodách registerExistingObject, registerNewContainerBean, registerNewContainerBeanForCMP, registerNewObject, registerObject, readIntoWorkingCopy

unitofwork_rollback=Počet odvolaných potvrzení objektů UnitOfWork

wrapping=Čas strávený cyklickým zalamováním objektů typu bean typu CMP a BMP

