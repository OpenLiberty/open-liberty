-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

# Hibernate version info
hibernateVersion=8.0.0.Beta1
hibernateModelsGroupId=org.hibernate.models
hibernateModelsVersion=1.3.0
byteBuddyVersion=1.18.10
jbossLoggingVersion=3.6.3.Final
antlrArtifactId=antlr4
antlrVersion=4.13.2
jandexVersion=3.5.3

Bundle-SymbolicName: io.openliberty.persistence.4.0.thirdparty
Bundle-Description: Hibernate JPA
Bundle-Distributor: IBM
Bundle-Activator: io.openliberty.persistence.internal.helper.HibernatePersistenceActivator
Bundle-Name: Hibernate JPA
Bundle-Vendor: Hibernate.org - Hibernate Project
Bundle-ManifestVersion: 2
Specification-Version: ${hibernateVersion}

javac.source: 21
javac.target: 21
Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

app-resources= \
  META-INF/services/org.hibernate.boot.registry.selector.StrategyRegistrationProvider | \
  META-INF/services/org.hibernate.integrator.spi.Integrator

Export-Package: \
            org.hibernate;version="${hibernateVersion}", \
            org.hibernate.annotations;version="${hibernateVersion}", \
            org.hibernate.boot;version="${hibernateVersion}", \
            org.hibernate.boot.model;version="${hibernateVersion}", \
            org.hibernate.boot.model.naming;version="${hibernateVersion}", \
            org.hibernate.boot.model.relational;version="${hibernateVersion}", \
            org.hibernate.boot.model.source;version="${hibernateVersion}", \
            org.hibernate.boot.registry;version="${hibernateVersion}", \
            org.hibernate.boot.registry.classloading.spi;version="${hibernateVersion}", \
            org.hibernate.boot.registry.selector;version="${hibernateVersion}", \
            org.hibernate.boot.registry.selector.spi;version="${hibernateVersion}", \
            org.hibernate.boot.spi;version="${hibernateVersion}", \
            org.hibernate.cache;version="${hibernateVersion}", \
            org.hibernate.cache.spi;version="${hibernateVersion}", \
            org.hibernate.cfg;version="${hibernateVersion}", \
            org.hibernate.context;version="${hibernateVersion}", \
            org.hibernate.context.spi;version="${hibernateVersion}", \
            org.hibernate.dialect;version="${hibernateVersion}", \
            org.hibernate.engine;version="${hibernateVersion}", \
            org.hibernate.engine.jdbc;version="${hibernateVersion}", \
            org.hibernate.engine.jdbc.spi;version="${hibernateVersion}", \
            org.hibernate.engine.spi;version="${hibernateVersion}", \
            org.hibernate.engine.transaction.spi;version="${hibernateVersion}", \
            org.hibernate.event.spi;version="${hibernateVersion}", \
            org.hibernate.id;version="${hibernateVersion}", \
            org.hibernate.integrator.spi;version="${hibernateVersion}", \
            org.hibernate.jpa;version="${hibernateVersion}", \
            org.hibernate.loader;version="${hibernateVersion}", \
            org.hibernate.mapping;version="${hibernateVersion}", \
            org.hibernate.metadata;version="${hibernateVersion}", \
            org.hibernate.metamodel;version="${hibernateVersion}", \
            org.hibernate.metamodel.spi;version="${hibernateVersion}", \
            org.hibernate.persister.entity;version="${hibernateVersion}", \
            org.hibernate.proxy;version="${hibernateVersion}", \
            org.hibernate.query;version="${hibernateVersion}", \
            org.hibernate.query.criteria;version="${hibernateVersion}", \
            org.hibernate.query.spi;version="${hibernateVersion}", \
            org.hibernate.resource.transaction.spi;version="${hibernateVersion}", \
            org.hibernate.service;version="${hibernateVersion}", \
            org.hibernate.service.spi;version="${hibernateVersion}", \
            org.hibernate.sql;version="${hibernateVersion}", \
            org.hibernate.stat;version="${hibernateVersion}", \
            org.hibernate.tool.schema;version="${hibernateVersion}", \
            org.hibernate.transform;version="${hibernateVersion}", \
            org.hibernate.tuple;version="${hibernateVersion}", \
            org.hibernate.type;version="${hibernateVersion}", \
            org.hibernate.type.spi;version="${hibernateVersion}", \
            org.hibernate.*;version="${hibernateVersion}", \
            net.bytebuddy;version="${byteBuddyVersion}", \
            net.bytebuddy.agent;version="${byteBuddyVersion}", \
            net.bytebuddy.description;version="${byteBuddyVersion}", \
            net.bytebuddy.dynamic;version="${byteBuddyVersion}", \
            net.bytebuddy.implementation;version="${byteBuddyVersion}", \
            net.bytebuddy.matcher;version="${byteBuddyVersion}", \
            org.jboss.logging;version="${jbossLoggingVersion}"

Import-Package: \
            com.ibm.tx.jta;version="[10.0,11)";resolution:=optional, \
            com.ibm.websphere.ras, \
            com.ibm.ws.Transaction;resolution:=optional, \
            com.ibm.ws.jpa.container.hibernate.logging;resolution:=optional, \
            com.ibm.wsspi.classloading,\
            !javax.activation, \
            javax.crypto;resolution:=optional, \
            javax.crypto.spec;resolution:=optional, \
            jakarta.enterprise.context.spi;resolution:=optional, \
            jakarta.enterprise.inject.spi;resolution:=optional, \
            javax.imageio;resolution:=optional, \
            javax.imageio.stream;resolution:=optional, \
            jakarta.jms;resolution:=optional, \
            jakarta.json, \
            jakarta.json.stream;resolution:=optional, \
            javax.management;resolution:=optional, \
            javax.management.openmbean;resolution:=optional, \
            jakarta.mail.internet;resolution:=optional, \
            javax.naming;resolution:=optional, \
            jakarta.persistence;jpa="4.0";consumer="persistenceService";resolution:=optional, \
            jakarta.persistence.criteria;jpa="4.0";consumer="persistenceService", \
            jakarta.persistence.metamodel;jpa="4.0";consumer="persistenceService", \
            jakarta.persistence.spi;jpa="4.0";consumer="persistenceService";resolution:=optional, \
            jakarta.resource;resolution:=optional, \
            jakarta.resource.cci;resolution:=optional, \
            javax.rmi;resolution:=optional, \
            javax.rmi.CORBA;resolution:=optional, \
            javax.sql;resolution:=optional, \
            jakarta.transaction;resolution:=optional, \
            javax.transaction.xa;resolution:=optional, \
            jakarta.validation;resolution:=optional, \
            jakarta.validation.groups;resolution:=optional, \
            jakarta.validation.metadata;resolution:=optional, \
            javax.xml.datatype;resolution:=optional, \
            javax.xml.namespace;resolution:=optional, \
            javax.xml.parsers;resolution:=optional, \
            javax.xml.stream;resolution:=optional, \
            javax.xml.stream.events;resolution:=optional, \
            javax.xml.transform;resolution:=optional, \
            javax.xml.transform.dom;resolution:=optional, \
            javax.xml.transform.sax;resolution:=optional, \
            javax.xml.transform.stream;resolution:=optional, \
            javax.xml.validation;resolution:=optional, \
            javax.xml.xpath;resolution:=optional, \
            org.hibernate.jpa, \
            org.omg.CORBA;resolution:=optional, \
            org.omg.CORBA.portable;resolution:=optional, \
            org.omg.CORBA_2_3.portable;resolution:=optional, \
            org.osgi.framework, \
            org.w3c.dom;resolution:=optional, \
            org.xml.sax;resolution:=optional, \
            org.xml.sax.ext;resolution:=optional, \
            org.xml.sax.helpers;resolution:=optional, \
            org.antlr.v4.runtime;resolution:=optional, \
            org.antlr.v4.runtime.atn;resolution:=optional, \
            org.antlr.v4.runtime.misc;resolution:=optional, \
            org.antlr.v4.runtime.tree;resolution:=optional, \
            org.antlr.v4.tool;resolution:=optional

# Use dynamicImport-Package for JAXB APIs, with this, Equinox will have a chance to wire
# those packages to the JAXB-2.2 API if the target bundle is started, or the one from system
# bundle will be always used due to JAXB 2.2 API is not resolved
DynamicImport-Package: \
 jakarta.activation,\
 jakarta.xml.bind, \
 jakarta.xml.bind.annotation, \
 jakarta.xml.bind.annotation.adapters, \
 jakarta.xml.bind.attachment, \
 jakarta.xml.bind.helpers, \
 jakarta.xml.bind.util

Include-Resource: \
  @${repo;org.hibernate.orm:hibernate-core;${hibernateVersion}}!/!(META-INF/MANIFEST.MF|OSGI-INF/*|module-info.class), \
  @${repo;${hibernateModelsGroupId}:hibernate-models;${hibernateModelsVersion}}!/!(META-INF/MANIFEST.MF|OSGI-INF/*|module-info.class), \
  @${repo;${hibernateModelsGroupId}:hibernate-models-bytebuddy;${hibernateModelsVersion}}!/!(META-INF/MANIFEST.MF|OSGI-INF/*|module-info.class), \
  @${repo;net.bytebuddy:byte-buddy;${byteBuddyVersion}}!/!(META-INF/MANIFEST.MF|OSGI-INF/*|module-info.class), \
  @${repo;org.jboss.logging:jboss-logging;${jbossLoggingVersion}}!/!(META-INF/MANIFEST.MF|OSGI-INF/*|module-info.class), \
  @${repo;io.smallrye:jandex;${jandexVersion}}!/!(META-INF/MANIFEST.MF|OSGI-INF/*|module-info.class), \
  @${repo;org.antlr:${antlrArtifactId};${antlrVersion}}!/!(META-INF/MANIFEST.MF|OSGI-INF/*|module-info.class)

Private-Package: io.openliberty.persistence.internal.helper

publish.wlp.jar.suffix: dev/api/third-party

# Exclude this bundle from instrumentation (RAS & FFDC trace injection)
instrument.disabled: true
instrument.ffdc: false

Service-Component: \
  io.openliberty.org.hibernate_${replace;${bVersion};\\.;_}.ResourceProvider; \
    implementation:=com.ibm.wsspi.classloading.ResourceProvider; \
    provide:=com.ibm.wsspi.classloading.ResourceProvider; \
    configuration-policy:=ignore; \
    properties:="resources=${app-resources}"

-buildpath: \
    org.hibernate.orm:hibernate-core;version=${hibernateVersion},\
    ${hibernateModelsGroupId}:hibernate-models;version=${hibernateModelsVersion},\
    ${hibernateModelsGroupId}:hibernate-models-bytebuddy;version=${hibernateModelsVersion},\
    net.bytebuddy:byte-buddy;version=${byteBuddyVersion},\
    org.jboss.logging:jboss-logging;version=${jbossLoggingVersion},\
    org.antlr:${antlrArtifactId};version=${antlrVersion},\
    io.smallrye:jandex;version=${jandexVersion},\
    io.openliberty.jakarta.persistence.4.0;version=latest,\
    com.ibm.websphere.org.osgi.core
