<server description="Server for testing Jandex index in WEB-INF/classes (appFalse, appMgrFalse)">

  <include location="../fatTestPorts.xml"/>

  <featureManager>
    <feature>servlet-3.1</feature>
  </featureManager>

  <javaPermission
    className="java.util.PropertyPermission"
    name="org.glassfish.web.rfc2109_cookie_names_enforced"
    actions="read"
    codebase="${server.config.dir}dropins/TestServlet40_WebInf.ear"/>

  <!-- appManager useJandex=false, application useJandex=false, readWebInfJandex=true -->
  <applicationManager useJandex="false"/>
  <application location="TestServlet40_WebInf.ear" useJandex="false" readWebInfJandex="true"/>

</server>
