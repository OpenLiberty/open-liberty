<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<attachments 
	xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
	xmlns:wsp="http://www.w3.org/ns/ws-policy" 
	xmlns:wsa="http://www.w3.org/2005/08/addressing"
	xmlns:sp="http://docs.oasis-open.org/ws-sx/ws-securitypolicy/200702"
	xmlns:wsat="http://docs.oasis-open.org/ws-tx/wsat/2006/06">
	<wsp:PolicyAttachment>
		<wsp:AppliesTo>
			<!-- URI portTypeOperation: require WS-AT for helloWithPolicy -->
			<wsp:URI>http://service1.policyattachments.ws.ibm.com/#wsdl11.portTypeOperation(HelloService1/helloWithPolicy)</wsp:URI>
			<!-- URI bindingOperation: require WS-AT for helloWithYouWant -->
			<wsp:URI>http://service1.policyattachments.ws.ibm.com/#wsdl11.bindingOperation(HelloService1SoapBinding/helloWithYouWant)</wsp:URI>
		</wsp:AppliesTo>
		<wsp:Policy wsu:Id="TransactedPolicy" >
			<wsat:ATAssertion />
		</wsp:Policy>
	</wsp:PolicyAttachment>
	<wsp:PolicyAttachment>
		<wsp:AppliesTo>
			<!-- URI bindingOperation: optional WS-AT for helloWithOptionalPolicy -->
			<wsp:URI>http://service1.policyattachments.ws.ibm.com/#wsdl11.bindingOperation(HelloService1SoapBinding/helloWithOptionalPolicy)</wsp:URI>
		</wsp:AppliesTo>
		<wsp:Policy wsu:Id="TransactedPolicy2" >
			<wsat:ATAssertion wsp:Optional="true" />
		</wsp:Policy>
	</wsp:PolicyAttachment>
	<wsp:PolicyAttachment>
		<wsp:AppliesTo>
			<!-- URI service-level selector: applies ATAssertion to all operations on HelloService2.
			     Uses the WSDL target namespace so no host/port is needed. -->
			<wsp:URI>http://service2.policyattachments.ws.ibm.com/#wsdl11.service(HelloService2)</wsp:URI>
		</wsp:AppliesTo>
		<wsp:Policy wsu:Id="TransactedPolicy" >
			<wsat:ATAssertion />
		</wsp:Policy>
	</wsp:PolicyAttachment>
</attachments>