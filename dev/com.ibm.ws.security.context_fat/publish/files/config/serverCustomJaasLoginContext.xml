<server>
    <featureManager>
        <feature>timedexit-1.0</feature>
        <feature>concurrent-1.0</feature>
        <feature>appSecurity-2.0</feature>
        <feature>ejbLite-3.2</feature>
        <feature>servlet-3.1</feature>
    </featureManager>
                 
    <library id="customTAILib">
        <fileset dir="${server.config.dir}" includes="CustomConcurTAI.jar,io.openliberty.org.apache.commons.codec.jar"/>      
    </library>  
    
        <javaPermission codebase="${server.config.dir}/CustomConcurTAI.jar" className="java.security.AllPermission" name="*" actions="*"/>
                     
    <include location="../fatTestPorts.xml"/>

    <variable name="onError" value="FAIL"/>

    <!--defines securityContext and jaasLoginContextEntry that it points to   -->
	<include location="includes/securityContextWithValidLoginContext.xml"/>
    
    <jaasLoginModule id="custom" className="com.ibm.ws.security.context_fat.CustomLoginModule" controlFlag="REQUIRED" libraryRef="customLoginLib"/>
	
  	<library id="customLoginLib">
		<fileset dir="${server.config.dir}" includes="CustomLoginAndTAI.jar"/>
    </library>
  
    <!-- Disable authentication cache to force login path on deserialization -->
    <authentication id="Basic" cacheEnabled="false" allowHashtableLoginWithIdOnly="true" />

	<!-- Basic authentication registry definition -->
    <basicRegistry id="basic" realm="TestRealm">
        <user name="user1" password="user1pwd" />
        <user name="user2" password="user2pwd" />
        <user name="user3" password="user3pwd" />         
    </basicRegistry>

    <application id="securityContextId" name="securityContext" type="ear" location="securityContext.ear">
        <application-bnd>
            <security-role name="role1">
                <user name="user1"/>
            </security-role>
            <security-role name="role2">
                <user name="user2"/>
            </security-role>
            <security-role name="role3">
                <user name="user3"/>
            </security-role>
        </application-bnd>
    </application>

</server>