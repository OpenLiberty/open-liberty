<web-app version="3.0"
    xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee web-app_3_0.xsd"
    id="WebApp_ID">

  <display-name>Security Context Test</display-name>
  <description>Tests security context serialization and deserialization</description>

    
  <!-- Authenticated Servlet Definition -->
  <servlet id="securedServletWithCacheKey">
    <servlet-name>SecuredServletWithCacheKey</servlet-name>
    <display-name>Secured with Cache Key Test Servlet</display-name>
    <servlet-class>com.ibm.test.servlet.SecuredServletWithCacheKey</servlet-class>
    <load-on-startup></load-on-startup>
  </servlet>
  
   <servlet-mapping id="securedServletWithCacheKey_mapping">
    <servlet-name>SecuredServletWithCacheKey</servlet-name>
    <url-pattern>/securedWithCacheKey/*</url-pattern>
  </servlet-mapping>
  
  <!-- SECURED SERVLET DEFINITIONS -->
  <servlet id="securedServlet">
    <servlet-name>SecuredServlet</servlet-name>
    <display-name>Secured Test Servlet</display-name>
    <servlet-class>com.ibm.test.servlet.SecuredServlet</servlet-class>
    <load-on-startup></load-on-startup>
  </servlet>
 
  <servlet-mapping id="securedServlet_mapping">
    <servlet-name>SecuredServlet</servlet-name>
    <url-pattern>/secured/*</url-pattern>
  </servlet-mapping>

  <!-- UNSECURED SERVLET DEFINITIONS -->
  <servlet id="unsecuredServlet">
    <servlet-name>UnsecuredServlet</servlet-name>
    <display-name>Unsecured Test Servlet</display-name>
    <servlet-class>com.ibm.test.servlet.UnsecuredServlet</servlet-class>
    <load-on-startup></load-on-startup>
  </servlet>
 
  <servlet-mapping id="unsecuredServlet_mapping">
    <servlet-name>UnsecuredServlet</servlet-name>
    <url-pattern>/unsecured/*</url-pattern>
  </servlet-mapping>
  
  <!-- SECURITY ROLES -->
  <security-role>
    <role-name>role1</role-name>
  </security-role>
  
  <security-role>
    <role-name>role2</role-name>
  </security-role>
  
  <!-- SECURITY CONSTRAINTS -->
  <security-constraint>
    <web-resource-collection>
      <url-pattern>/secured/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>role1</role-name>
      <role-name>role2</role-name>
      <role-name>role3</role-name>
    </auth-constraint>
  </security-constraint>
  
  <security-constraint>
    <web-resource-collection>
      <url-pattern>/securedWithCacheKey/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>role1</role-name>
      <role-name>role2</role-name>
    </auth-constraint>
  </security-constraint>

  <!-- AUTHENTICATION METHOD -->
  <login-config>
    <auth-method>BASIC</auth-method>
  </login-config>
    
</web-app>
