-include= ~../cnf/resources/bnd/bundle.props

bVersion=1.0

Bundle-Name: Hibernate JPA Container
Bundle-SymbolicName: com.ibm.ws.jpa.container.hibernate
Bundle-Description: Container-managed Hibernate JPA support, version ${bVersion}

WS-TraceGroup: JPA

-dsannotations: com.ibm.ws.jpa.container.hibernate.HibernateJPAProvider

Export-Package: \
 com.ibm.ws.jpa.container.hibernate, \
 com.ibm.ws.jpa.container.hibernate.logging

Import-Package: \
 !com.ibm.ws.jpa.container.hibernate, \
 org.hibernate.jpa;version="[8.0,9.0)", \
 *

-buildpath: \
	com.ibm.ws.jpa.container.core;version=latest,\
	com.ibm.ws.container.service;version=latest,\
	io.openliberty.jakarta.persistence.4.0;version=latest,\
	io.openliberty.persistence.4.0.thirdparty;version=latest,\
	com.ibm.websphere.appserver.spi.logging;version=latest,\
	com.ibm.wsspi.org.osgi.service.component.annotations;version=latest, \
	com.ibm.ws.org.osgi.annotation.versioning;version=latest
