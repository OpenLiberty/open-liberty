<?xml version="1.0" encoding="UTF-8"?>
<server description="REST Admin JWT TAI FAT Server">
    <include location="../fatTestPorts.xml"/>

    <featureManager>
        <feature>restConnector-2.0</feature>
        <feature>jwt-1.0</feature>
        <feature>appSecurity-2.0</feature>
    </featureManager>

    <keyStore id="defaultKeyStore" password="Liberty" />
    <ltpa keysPassword="password" />

    <!-- Route the admin REST connector (IBMJMXConnectorREST) through a dedicated admin endpoint/virtual host -->
    <variable name="admin.virtual.host" value="admin_host"/>
    <virtualHost id="admin_host" allowFromEndpointRef="adminEndpoint">
        <hostAlias>*:${bvt.prop.HTTP_secondary.secure}</hostAlias>
    </virtualHost>
    <httpEndpoint id="adminEndpoint" host="*" httpPort="-1" httpsPort="${bvt.prop.HTTP_secondary.secure}"/>

    <!-- RS256 with no trustedAlias: the public keys come from the JSON Web Key Set that the tests write to
         resources/security/jwks.json under the server directory before the server starts. -->
    <jwtConsumer id="JMXConnectorRESTConsumer"
                 issuer="IBMJMXConnectorRESTIssuer"
                 audiences="IBMJMXConnectorREST"
                 jwkEnabled="true"
                 jwkEndpointUrl="file:${server.config.dir}resources/security/jwks.json"
                 signatureAlgorithm="RS256"
                 clockSkew="1m" />

    <!-- No user registry. The tokens carry user and group access IDs, so the roles are mapped by access ID. -->
    <administrator-role>
        <group>group:defaultWIMFileBasedRealm/liberty-admin</group>
    </administrator-role>
    <reader-role>
        <group>group:defaultWIMFileBasedRealm/liberty-reader</group>
    </reader-role>
</server>
