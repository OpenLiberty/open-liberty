-include ~../cnf/resources/bnd/bundle.props

bVersion=1.0

Bundle-SymbolicName: io.openliberty.org.mcpjava.mcp-server-api; singleton:=true

publish.wlp.jar.suffix: dev/api/stable

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=17))"

javac.source: 17
javac.target: 17

WS-TraceGroup: MCP

Export-Package: \
  org.mcpjava.server.*;version="1.0"

Include-Resource: \
  @${repo;org.mcpjava:mcp-server-api;1.0.0}

-maven-dependencies: \
   dep1;groupId=org.mcpjava;artifactId=mcp-server-api;version=1.0.0;scope=runtime

-buildpath: \
  org.mcpjava:mcp-server-api
