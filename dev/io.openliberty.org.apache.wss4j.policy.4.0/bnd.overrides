-include= ~../cnf/resources/bnd/rejar.props
bVersion=4.0.0

Bundle-Name: io.openliberty.org.apache.wss4j.policy.4.0
Bundle-Description: org.apache.wss4j.wss4j.policy; version=4.0.0
Bundle-SymbolicName: io.openliberty.org.apache.wss4j.policy.4.0
Bundle-ActivationPolicy: lazy

WS-TraceGroup: WSS4J

Export-Package: \
 org.apache.wss4j.policy.*;version=${bVersion}

Import-Package: \
 org.apache.jcp.xml.dsig.internal.*;version="[2.3.0,5.0.0)",\
 org.apache.xml.security.*;version="[2.3.0,5.0.0)",\
 * 
 
 -includeresource: \
 @${repo;org.apache.wss4j:wss4j-policy;${wss4jVersion}}!/!META-INF/MANIFEST.MF,\
 @${repo;org.apache.wss4j:wss4j-policy;${wss4jVersion}}!/templates/**,\
 @${repo;org.apache.wss4j:wss4j-policy;${wss4jVersion}}!/schemas/**,\
 @${repo;org.apache.wss4j:wss4j-policy;${wss4jVersion}}!/*xml,\
 org/apache/wss4j/policy=${bin}/org/apache/wss4j/policy
 