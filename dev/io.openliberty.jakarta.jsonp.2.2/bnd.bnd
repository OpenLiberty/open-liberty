# Local-source overlay: builds the Jakarta JSON-P API from src/ (provider-cache
# branch of jsonp-api) 
#
# TODO update to Maven dependency after Milestone release

-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

javac.source: 17
javac.target: 17

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=17))"

Bundle-SymbolicName: io.openliberty.jakarta.jsonp.2.2

# Optionally import eclipse Parsson impl because spec jar does Class.forName() of it as a fallback option
Import-Package: \
   org.eclipse.parsson;resolution:=optional, \
   *

Export-Package: \
   jakarta.json;thread-context=true;version=2.2, \
   jakarta.json.spi;version=2.2, \
   jakarta.json.stream;version=2.2

instrument.disabled: true

publish.wlp.jar.suffix: dev/api/spec
