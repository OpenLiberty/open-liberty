-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

src: \
    fat/src,\
    test-applications/EJBEventEJB.jar/src,\
    test-applications/EJBEventWeb.war/src,\
    test-applications/EJBEventWar.war/src,\
    test-applications/EJBEventJar.jar/src,\
    test-applications/EJBEventJarWeb.war/src

fat.project: true

# Features exercised by EE repeat actions that are NOT in any server.xml.
tested.features: \
    enterpriseBeansLite-4.0,\
    enterpriseBeansHome-4.0,\
    enterpriseBeansRemote-4.0,\
    enterpriseBeansPersistentTimer-4.0,\
    mdb-4.0,\
    jca-1.7,\
    connectors-2.0,\
    connectors-2.1,\
    messagingClient-3.0,\
    messagingServer-3.0,\
    messaging-3.1,\
    wasJmsServer-1.0,\
    wasJmsClient-2.0,\
    servlet-4.0,\
    servlet-5.0,\
    servlet-6.0,\
    servlet-6.1

-buildpath: \
    com.ibm.websphere.javaee.annotation.1.1;version=latest,\
    com.ibm.websphere.javaee.ejb.3.1;version=latest,\
    com.ibm.websphere.javaee.jms.1.1;version=latest,\
    com.ibm.websphere.javaee.servlet.3.1;version=latest
