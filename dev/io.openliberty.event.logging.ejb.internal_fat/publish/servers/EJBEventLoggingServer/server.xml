<server description="EJB Event Logging FAT server" quiesceTimeout="90s">

    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>ejbLite-3.2</feature>
        <feature>ejbHome-3.2</feature>
        <feature>ejbRemote-3.2</feature>
        <feature>ejbPersistentTimer-3.2</feature>
        <feature>mdb-3.2</feature>
        <feature>wasJmsServer-1.0</feature>
        <feature>wasJmsClient-2.0</feature>
        <feature>eventLogging-1.0</feature>
        <feature>componenttest-1.0</feature>
        <feature>noShip-1.0</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

	<applicationManager startTimeout="90s"/>
    <orb id="defaultOrb" orbSSLInitTimeout="90"/>

    <!-- Log all EJB events immediately so tests can assert BEGIN/END lines -->
    <eventLogging includeContextInfo="true" minDuration="0" eventTypes="all"/>

    <!-- JMS messaging engine - three queues, one per application packaging -->
    <messagingEngine>
        <queue id="EJBEventEarQueue"/>
        <queue id="EJBEventWarQueue"/>
        <queue id="EJBEventJarQueue"/>
    </messagingEngine>

    <jmsQueueConnectionFactory id="EJBEventQCF" jndiName="jms/EJBEventQCF">
        <properties.wasJms/>
    </jmsQueueConnectionFactory>

    <jmsQueue id="EJBEventEarQueue" jndiName="jms/EJBEventEarQueue">
        <properties.wasJms queueName="EJBEventEarQueue"/>
    </jmsQueue>

    <jmsQueue id="EJBEventWarQueue" jndiName="jms/EJBEventWarQueue">
        <properties.wasJms queueName="EJBEventWarQueue"/>
    </jmsQueue>

    <jmsQueue id="EJBEventJarQueue" jndiName="jms/EJBEventJarQueue">
        <properties.wasJms queueName="EJBEventJarQueue"/>
    </jmsQueue>

    <!-- Activation specs - id must match <appName>/<moduleName>/<beanName> -->
    <!-- EAR MDB: app=EJBEventApp, module=EJBEventEJB, bean=MDBBean -->
    <jmsActivationSpec id="EJBEventApp/EJBEventEJB/MDBBean">
        <properties.wasJms destinationRef="EJBEventEarQueue"/>
    </jmsActivationSpec>

    <!-- Standalone WAR MDB: module=EJBEventWar, bean=MDBBeanInWar -->
    <jmsActivationSpec id="EJBEventWar/MDBBeanInWar">
        <properties.wasJms destinationRef="EJBEventWarQueue"/>
    </jmsActivationSpec>

    <!-- Standalone JAR MDB: module=EJBEventJar, bean=MDBBeanInJar -->
    <jmsActivationSpec id="EJBEventJar/MDBBeanInJar">
        <properties.wasJms destinationRef="EJBEventJarQueue"/>
    </jmsActivationSpec>

    <application id="EJBEventApp" name="EJBEventApp" type="ear"
                 location="${server.config.dir}/apps/EJBEventApp.ear"/>

    <application id="EJBEventWar" name="EJBEventWar" type="war"
                 location="${server.config.dir}/apps/EJBEventWar.war"/>

    <application id="EJBEventJar" name="EJBEventJar" type="ejb"
                 location="${server.config.dir}/apps/EJBEventJar.jar"/>

    <application id="EJBEventJarWeb" name="EJBEventJarWeb" type="war"
                 location="${server.config.dir}/apps/EJBEventJarWeb.war"/>

</server>
