-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

src: \
	fat/src,\
	test-applications/val40/src

fat.project: true

javac.source: 21
javac.target: 21

fat.minimum.java.level: 21
fat.project: true

# Use the Jakarta Validation 4.0 M1 jar directly from the local Maven repository.
# Replace with the released 4.0 GAR artifact once available.
-buildpath: \
	io.openliberty.jakarta.cdi.4.0;version=latest,\
	io.openliberty.jakarta.servlet.6.1;version=latest,\
	jakarta.validation:jakarta.validation-api;version=4.0.0.M1;strategy=exact,\
	com.ibm.ws.componenttest.2.0;version=latest
