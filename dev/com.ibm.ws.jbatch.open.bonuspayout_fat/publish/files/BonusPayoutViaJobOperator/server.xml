<server>

    <include location="../fatTestPorts.xml" />

	<featureManager>
		<feature>osgiconsole-1.0</feature>
		<feature>batch-1.0</feature>
		<feature>cdi-1.2</feature>
		<feature>servlet-3.1</feature>
	</featureManager>

    <batchPersistence jobStoreRef="BatchDatabaseStore" />

    <databaseStore id="BatchDatabaseStore" dataSourceRef="BonusPayout" schema="JBATCH" tablePrefix="" />

	<library id="H2Lib">
	    <file name="${shared.resource.dir}/h2/h2.jar"/>
	</library>

	<!--  Both use the same DB -->
	<dataSource id="BonusPayoutNoTran" jndiName="jdbc/BonusPayoutNoTranDS" type="javax.sql.ConnectionPoolDataSource" transactional="false">
		<jdbcDriver libraryRef="H2Lib" />
	       <properties.h2 URL="jdbc:h2:mem:BonusPayoutDB;DB_CLOSE_DELAY=-1;INIT=CREATE SCHEMA IF NOT EXISTS JBATCH\;CREATE SCHEMA IF NOT EXISTS BONUSPAYOUT;NON_KEYWORDS=VALUE" user="user" password="pass" />
	</dataSource>

	<dataSource id="BonusPayout" jndiName="jdbc/BonusPayoutDS" type="javax.sql.XADataSource">
		<jdbcDriver libraryRef="H2Lib" />
	       <properties.h2 URL="jdbc:h2:mem:BonusPayoutDB;DB_CLOSE_DELAY=-1;INIT=CREATE SCHEMA IF NOT EXISTS JBATCH\;CREATE SCHEMA IF NOT EXISTS BONUSPAYOUT;NON_KEYWORDS=VALUE" user="user" password="pass" />
	</dataSource>

	<javaPermission className="java.util.PropertyPermission" name="*" actions="read"/>
	<javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/h2/h2.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${server.config.dir}/dropins/BonusPayout.war"/>

</server>
