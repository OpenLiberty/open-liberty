-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-SymbolicName: io.openliberty.org.hibernate.models.bytebuddy; singleton:=true
Bundle-Description: Hibernate Models ByteBuddy, version 1.3.0

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

-includeresource: \
  @${repo;org.hibernate.models:hibernate-models-bytebuddy;1.3.0;EXACT}!/!module-info.class

instrument.disabled: true

-buildpath: \
        org.hibernate.models:hibernate-models-bytebuddy;version=1.3.0, \
        com.ibm.ws.org.osgi.annotation.versioning;version=latest
