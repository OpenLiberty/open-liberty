<server description="com.ibm.ws.security.audit.fat.config">

	<featureManager>
		<feature>appSecurity-2.0</feature>
		<feature>servlet-3.1</feature>
		<feature>audit-1.0</feature>
	</featureManager>

    <!-- pwd: Liberty, expires 9/2/2037 -->
    <keyStore
         id="auditSignKeyStore"
         password="Liberty"
         location="${server.config.dir}/resources/security/AuditSigningKeyStore.jks"
         type="JKS" />
         
    <keyStore
         id="auditEncKeyStore"
         password="{xor}EzY9Oi0rJg=="
         location="${server.config.dir}/resources/security/AuditEncryptionKeyStore2.jks"
         type="JKS" />


	<auditFileHandler 
		 encrypt="true"
         encryptAlias="enccert2"
         encryptKeyStoreRef="auditEncKeyStore"
		 sign="true"
         signingAlias="auditsigning"
         signingKeyStoreRef="auditSignKeyStore">
	    <events name="SuccessOnly1" outcome="SUCCESS" eventName="SECURITY_AUTHN" />
	    <events name="SuccessOnly2" outcome="SUCCESS" eventName="SECURITY_AUDIT_MGMT" />
	</auditFileHandler>

	<basicRegistry id="basic" realm="BasicRealm">
		<user name="user0" password="user0pwd" />
		<user name="user1" password="user1pwd" />
		<group name="group1">
			<member name="user0" />
			<member name="user1" />
		</group>
	</basicRegistry>

 	<application type="war" id="AuditBasicAuthServlet" name="AuditBasicAuthServlet" location="AuditBasicAuthServlet.war">
 		<application-bnd>
			<security-role name="audit_basic">
				<user name="user1" />
				<group name="group1" />
			</security-role>	
			<security-role name="audit_form">
				<user name="user2" />
				<group name="group2" />
			</security-role>	
			<security-role name="AllAuthenticated">
				<special-subject type="ALL_AUTHENTICATED_USERS" />
			</security-role>
		</application-bnd>
	</application>

	<include location="../fatTestPorts.xml" />

</server>
