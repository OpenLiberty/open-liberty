-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: JPA Container Jakarta 4.0
Bundle-SymbolicName: com.ibm.ws.jpa.container.jakarta.40
Bundle-Description: Container-managed JPA support for JPA 4.0; version ${bVersion}

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

WS-TraceGroup: JPA

# Pull every class/resource from the transformed base jar, then overlay only
# AbstractJPAPUnitInfo.class compiled against the JPA 4.0 API (non-spi import).
# The later entry wins, replacing the transformer-produced version.
-includeresource: \
    @${repo;com.ibm.ws.jpa.container.jakarta;latest}, \
    com/ibm/ws/jpa/management/AbstractJPAPUnitInfo.class=\
        ${bin}/com/ibm/ws/jpa/management/AbstractJPAPUnitInfo.class, \
    com/ibm/ws/jpa/management/JPACompPUnitInfo.class=\
        ${bin}/com/ibm/ws/jpa/management/JPACompPUnitInfo.class

# The base jar's Service-Component header is not carried forward automatically
# by bnd's @{repo;...} include — we must re-declare it so the OSGi SCR processes
# all DS component XMLs from OSGI-INF/ and registers JPAComponentImpl as an
# ApplicationStateListener (which drives persistence.xml scanning and
# @PersistenceContext injection).
Service-Component: \
    OSGI-INF/com.ibm.ws.jpa.pctxtAttributeAccessor.xml, \
    OSGI-INF/com.ibm.ws.jpa.jpaRuntime.xml, \
    OSGI-INF/com.ibm.ws.jpa.serialization.classProvider.xml, \
    OSGI-INF/com.ibm.ws.jpa.container.osgi.internal.JPAComponentImpl.xml, \
    OSGI-INF/com.ibm.ws.jpa.container.osgi.internal.JPAPCtxtProcessorProvider.xml, \
    OSGI-INF/com.ibm.ws.jpa.container.osgi.internal.JPAPUnitProcessorProvider.xml, \
    OSGI-INF/com.ibm.ws.jpa.container.osgi.internal.url.JPAURLStreamHandler.xml, \
    OSGI-INF/com.ibm.ws.jpa.container.osgi.jndi.JPAJndiLookupObjectFactory.xml

# Export the same packages the base jar exports so downstream bundles see no difference.
Export-Package: \
    com.ibm.ws.jpa, \
    com.ibm.ws.jpa.management, \
    com.ibm.ws.jpa.container.osgi.jndi

Private-Package: \
    !org.apache.geronimo.*, \
    *.jpa.*

# The 4.0 API places PersistenceUnitTransactionType in the top-level package (not spi).
Import-Package: \
    jakarta.persistence;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.criteria;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.metamodel;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.query;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.spi;jpa="4.0";consumer="persistenceService", \
    !javax.activation, \
    !javax.xml.bind.*, \
    *

DynamicImport-Package: \
    javax.activation, \
    javax.xml.bind, \
    javax.xml.bind.annotation, \
    javax.xml.bind.annotation.adapters, \
    javax.xml.bind.attachment, \
    javax.xml.bind.helpers, \
    javax.xml.bind.util, \
    org.glassfish.jaxb.*

-buildpath: \
    com.ibm.ws.jpa.container.jakarta;version=latest, \
    io.openliberty.jakarta.persistence.4.0;version=latest, \
    com.ibm.ws.logging.core, \
    com.ibm.ws.org.osgi.annotation.versioning;version=latest, \
    com.ibm.ws.container.service;version=latest, \
    com.ibm.ws.jpa.container.core;version=latest
