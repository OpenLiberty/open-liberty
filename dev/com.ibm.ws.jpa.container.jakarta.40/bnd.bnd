-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: JPA Container Jakarta 4.0
Bundle-SymbolicName: com.ibm.ws.jpa.container.jakarta.40
Bundle-Description: Container-managed JPA support for JPA 4.0; version ${bVersion}

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

WS-TraceGroup: JPA

# Pull every class/resource from the transformed base jar, then overlay the
# two abstract base classes compiled against the JPA 4.0 API (non-spi import).
# The later entries win, replacing the transformer-produced versions.
# JPACompPUnitInfo is NOT re-specified — it lives entirely in com.ibm.ws.jpa.container.core
# (gets transformed) and carries no API-version-sensitive descriptors.
-includeresource: \
    @${repo;com.ibm.ws.jpa.container.jakarta;latest}, \
    com/ibm/ws/jpa/management/AbstractJPAPUnitInfo.class=\
        ${bin}/com/ibm/ws/jpa/management/AbstractJPAPUnitInfo.class, \
    com/ibm/ws/jpa/management/AbstractJPACompPUnitInfo.class=\
        ${bin}/com/ibm/ws/jpa/management/AbstractJPACompPUnitInfo.class

# The DS components from the base jar are included via @{repo;...}.
# Re-declare -dsannotations so bnd picks up the @Component classes from the
# overlay-compiled sources (AbstractJPAPUnitInfo, AbstractJPACompPUnitInfo), and
# declare Service-Component for the XML-driven components already in OSGI-INF/.
-dsannotations: \
    com.ibm.ws.jpa.container.osgi.internal.JPAComponentImpl, \
    com.ibm.ws.jpa.container.osgi.internal.JPAPCtxtProcessorProvider, \
    com.ibm.ws.jpa.container.osgi.internal.JPAPUnitProcessorProvider, \
    com.ibm.ws.jpa.container.osgi.internal.url.JPAURLStreamHandler, \
    com.ibm.ws.jpa.container.osgi.jndi.JPAJndiLookupObjectFactory

Service-Component: \
    com.ibm.ws.jpa.pctxtAttributeAccessor;\
        implementation:=com.ibm.ws.jpa.management.JPAPCtxtAttributeAccessor;\
        provide:=com.ibm.ws.jpa.management.JPAPCtxtAttributeAccessor;\
        properties:="service.ranking:Integer=20",\
    com.ibm.ws.jpa.jpaRuntime;\
        implementation:=com.ibm.ws.jpa.management.JPA20Runtime;\
        provide:=com.ibm.ws.jpa.management.JPARuntime,\
    com.ibm.ws.jpa.serialization.classProvider;\
        implementation:=com.ibm.ws.serialization.DeserializationClassProvider;\
        provide:=com.ibm.ws.serialization.DeserializationClassProvider;\
        properties:="service.vendor=IBM,\
    classes=com.ibm.ws.jpa.JPAPuId\
            |com.ibm.ws.jpa.management.JPATxEntityManager\
            |com.ibm.ws.jpa.management.JPAEMFactory"

# Export the same packages the base jar exports so downstream bundles see no difference.
Export-Package: \
    com.ibm.ws.jpa, \
    com.ibm.ws.jpa.management, \
    com.ibm.ws.jpa.container.osgi.jndi

Private-Package: \
    !org.apache.geronimo.*, \
    *.jpa.*

# The 4.0 API places PersistenceUnitTransactionType in the top-level package (not spi).
Import-Package: \
    jakarta.persistence;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.criteria;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.metamodel;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.query;jpa="4.0";consumer="persistenceService", \
    jakarta.persistence.spi;jpa="4.0";consumer="persistenceService", \
    !jakarta.activation, \
    !jakarta.xml.bind.*, \
    *

DynamicImport-Package: \
    jakarta.activation, \
    jakarta.xml.bind, \
    jakarta.xml.bind.annotation, \
    jakarta.xml.bind.annotation.adapters, \
    jakarta.xml.bind.attachment, \
    jakarta.xml.bind.helpers, \
    jakarta.xml.bind.util, \
    org.glassfish.jaxb.*

-buildpath: \
    com.ibm.ws.jpa.container.jakarta;version=latest, \
    io.openliberty.jakarta.persistence.4.0;version=latest, \
    com.ibm.ws.logging.core, \
    com.ibm.ws.org.osgi.annotation.versioning;version=latest, \
    com.ibm.ws.container.service;version=latest
