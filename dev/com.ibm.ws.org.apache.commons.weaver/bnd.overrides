-include= ~../cnf/resources/bnd/rejar.props
bVersion=1.0

Bundle-Name: Apache Commons Weaver
Bundle-SymbolicName: com.ibm.ws.org.apache.commons.weaver
Bundle-Description: Apache Commons Weaver; version=2.0
  
Export-Package: \
  org.apache.commons.weaver.privilizer.*;version="2.0", \
  org.apache.commons.weaver.model.*, \
  org.apache.commons.weaver.spi.*, \
  org.apache.commons.weaver.utils.*

Include-Resource: \
  @${repo;org.apache.commons:commons-weaver-privilizer;2.0}!/META-INF/LICENSE.txt, \
  @${repo;org.apache.commons:commons-weaver-privilizer;2.0}!/META-INF/NOTICE.txt

Import-Package: !org.apache.commons.io, *