-include= ~../cnf/resources/bnd/bundle.props

-sub: *.bnd

bVersion=1.0

-dsannotations: \
  io.openliberty.grpc.internal.server.security.GrpcSecurityComponent

Import-Package: \
  *

-buildpath: \
  io.openliberty.grpc.1.0.internal;version=latest,\
  com.ibm.websphere.javaee.servlet.4.0;version=latest,\
  com.ibm.ws.org.osgi.annotation.versioning;version=latest,\
  com.ibm.ws.logging.core,\
  com.ibm.ws.security.authorization.util,\
  org.osgi.service.component.annotations;version=latest
