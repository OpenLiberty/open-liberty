-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

src: \
    fat/src, \
    test-applications/authenticationService/src

fat.project: true
tested.features: appsecurity-1.0, jsp-2.2, servlet-3.1, distributedmap-1.0, jndi-1.0

-buildpath: \
    io.openliberty.org.apache.commons.codec;version=latest,\
    io.openliberty.org.apache.commons.logging;version=latest,\
    com.ibm.websphere.javaee.servlet.3.1;version=latest,\
    com.ibm.websphere.org.osgi.core;version=latest,\
    com.ibm.websphere.security;version=latest,\
    com.ibm.ws.logging.core;version=latest,\
    com.ibm.ws.security.authentication;version=latest,\
    com.ibm.ws.security.credentials;version=latest,\
    com.ibm.ws.security.jaas.common;version=latest,\
    com.ibm.ws.security.token;version=latest,\
    com.ibm.ws.webcontainer.security_test.servlets;version=latest,\
    org.apache.httpcomponents:httpclient;version=4.1.2,\
    org.apache.httpcomponents:httpcore;version=4.1.2

# Copy in FIPS keys
ltpa.fips.enabled: true
