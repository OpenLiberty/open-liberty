<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app id="AuthenticationServlet">
  <display-name>AuthenticationServlet</display-name>
  <description>This is a servlet to test the authentication service.</description>

  <!-- SERVLET DEFINITIONS -->
  <servlet id="Default">
    <servlet-name>AuthenticationServlet</servlet-name>
    <display-name>AuthenticationServlet</display-name>
    <description>Authentication Service FAT servlet</description>
    <servlet-class>web.AuthenticationServlet</servlet-class>
    <load-on-startup></load-on-startup>
  </servlet>

  <!-- SERVLET MAPPINGS -->        
  <servlet-mapping id="ServletMapping_Default">
    <servlet-name>AuthenticationServlet</servlet-name>
    <url-pattern>/*</url-pattern>
  </servlet-mapping>
</web-app>
