-include= ~../cnf/resources/bnd/bundle.props

bVersion=1.0

Bundle-SymbolicName: io.openliberty.persistence.service.hibernate
Bundle-Description: Liberty Persistence Service backed by Hibernate 8.x for Jakarta EE 12

WS-TraceGroup: persistenceservice

Export-Package: com.ibm.wsspi.persistence; version="1.0.16"

Private-Package: \
  com.ibm.wsspi.persistence.internal, \
  com.ibm.wsspi.persistence.internal.jta, \
  com.ibm.wsspi.persistence.internal.util

Import-Package: \
  jakarta.persistence; version="[4.0,5)"; consumer=persistenceService, \
  jakarta.persistence.spi; version="[4.0,5)"; consumer=persistenceService, \
  jakarta.transaction; version="[2.0,3)", \
  *

Include-Resource:\
    OSGI-INF=resources/OSGI-INF

IBM-Default-Config: OSGI-INF/wlp/defaultInstances.xml

-dsannotations: \
  com.ibm.wsspi.persistence.internal.HibernatePersistenceServiceImpl,\
  com.ibm.wsspi.persistence.internal.InMemoryUrlStreamHandler,\
  com.ibm.wsspi.persistence.internal.HibernateDatabaseStoreImpl

instrument.classesExcludes: com/ibm/wsspi/persistence/internal/PersistenceServiceMessages*.class

javac.source: 21
javac.target: 21

-buildpath: \
  com.ibm.websphere.appserver.spi.logging;version=latest,\
  io.openliberty.jakarta.persistence.4.0;version=latest,\
  org.hibernate.orm:hibernate-core;version=8.0.0.Beta3,\
  com.ibm.websphere.org.osgi.core;version=latest,\
  com.ibm.websphere.org.osgi.service.component;version=latest,\
  com.ibm.wsspi.org.osgi.service.component.annotations;version=latest,\
  com.ibm.websphere.appserver.spi.kernel.service;version=latest,\
  com.ibm.ws.resource;version=latest,\
  com.ibm.ws.tx.embeddable.jakarta;version=latest,\
  com.ibm.tx.jta.jakarta;version=latest,\
  com.ibm.ws.jdbc;version=latest,\
  com.ibm.ws.org.osgi.annotation.versioning;version=latest,\
  com.ibm.websphere.appserver.api.authData;version=latest,\
  com.ibm.ws.kernel.boot.common;version=latest,\
  io.openliberty.checkpoint;version=latest,\
  io.openliberty.jakarta.transaction.2.0;version=latest
