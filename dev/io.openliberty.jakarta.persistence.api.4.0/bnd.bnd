-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-SymbolicName: io.openliberty.jakarta.persistence.api.4.0
Require-Bundle: io.openliberty.org.eclipse.persistence-4.0
-exportcontents: \
 jakarta.persistence; \
 jakarta.persistence.criteria; \
 jakarta.persistence.metamodel; \
 jakarta.persistence.spi; \
   jpa="4.0"; version="4.0.0"

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

