-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-SymbolicName: com.ibm.websphere.org.eclipse.microprofile.reactive.messaging.1.0; singleton:=true

Import-Package: \
  javax.enterprise.util; version="[2.0,3)",\
  org.eclipse.microprofile.config; version="[1.0,2)",\
  org.eclipse.microprofile.reactive.streams.operators; version="[1.0,2)",\
  *

Export-Package: \
  org.eclipse.microprofile.reactive.messaging;version=1.0,\
  org.eclipse.microprofile.reactive.messaging.spi;version=1.0

Include-Resource: \
  @${repo;org.eclipse.microprofile.reactive.messaging:microprofile-reactive-messaging-api;1.0;EXACT}

WS-TraceGroup: REACTIVEMESSAGE

 -maven-dependencies: \
   dep1;groupId=org.eclipse.microprofile.reactive.messaging;artifactId=microprofile-reactive-messaging-api;version=1.0;scope=runtime
