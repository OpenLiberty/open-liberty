<server>

    <featureManager>
        <feature>jdbc-4.1</feature>
        <feature>jndi-1.0</feature>
        <feature>localConnector-1.0</feature>
        <feature>servlet-3.1</feature>
    </featureManager>

    <library id="DerbyLib" fat.modify="true">
        <fileset dir="${shared.resource.dir}/derby"/>
    </library>

    <!-- Datasource used by validateConnections MBean test -->
    <dataSource id="dsfatValidate" jndiName="jdbc/dsfatValidate">
        <jdbcDriver libraryRef="DerbyLib"/>
        <properties.derby.embedded databaseName="memory:dsValidate" createDatabase="create"/>
    </dataSource>

    <javaPermission codeBase="${shared.resource.dir}/derby/derby.jar" className="java.security.AllPermission"/>

    <include location="../fatTestPorts.xml"/>

</server>
