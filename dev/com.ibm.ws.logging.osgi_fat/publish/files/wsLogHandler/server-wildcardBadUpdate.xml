<server description="WsLogHandler FAT Test Server - Wildcard IDs, dynamic update with invalid patterns">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Same valid patterns as WsLogHandlerWildcardServer/server.xml, plus two invalid patterns
         added dynamically: CWLFX*K (invalid level) and CWLFY** (multiple asterisks). -->
    <wsLogHandler routerThing="CWLFA*,CWLFB*W,CWLFC*A,CWLFD*E,CWLFX*K,CWLFY**" />

</server>
