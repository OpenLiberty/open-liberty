<server description="WsLogHandler FAT Test Server - Combined Exact and Wildcard IDs, dynamic update">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Updated routerThing relative to WsLogHandlerCombinedServer/server.xml:
           Removed:  CWLFA*     (wildcard — plain prefix)
                     CWLFB0001I (exact ID)
           Retained: CWLFC*A    (wildcard — level-qualified AUDIT, unchanged)
                     CWLFD0003E (exact ID, unchanged)
           Added:    CWLFE*W    (new wildcard — level-qualified WARNING)
                     CWLFM0007I (new exact ID)
           Invalid:  CWLFN**    (multiple asterisks — must emit CWWKE0710W, must NOT route)
                     CWLFO*Z    (unrecognised level letter — must emit CWWKE0710W, must NOT route) -->
    <wsLogHandler routerThing="CWLFC*A,CWLFD0003E,CWLFE*W,CWLFM0007I,CWLFN**,CWLFO*Z" />

</server>
