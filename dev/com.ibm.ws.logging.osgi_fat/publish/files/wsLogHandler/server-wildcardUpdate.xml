<server description="WsLogHandler FAT Test Server - Wildcard IDs, dynamic update">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Updated routerThing relative to WsLogHandlerWildcardServer/server.xml:
           Removed:   CWLFA*  (plain prefix)
                      CWLFD*E (level-qualified ERROR)
           Narrowed:  CWLFB*W -> CWLFB02*W (prefix now includes number range; only CWLFB02xxW matches)
           Retained:  CWLFC*A (level-qualified AUDIT, unchanged)
           Added:     CWLFG*  (new plain prefix, any level)
                      CWLFH*I (new level-qualified INFO) -->
    <wsLogHandler routerThing="CWLFB02*W,CWLFC*A,CWLFG*,CWLFH*I" />

</server>
