<server description="WsLogHandler FAT Test Server - Combined Exact and Wildcard IDs">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Configure combined exact IDs and wildcard message ID patterns matching Open Liberty conventions:
         CWWKF* (prefix wildcard), CWWKE0001I (exact ID), CWWKS*A (prefix+level wildcard), CWWKZ0012E (exact error ID) -->
    <wsLogHandler routerThing="CWWKF*,CWWKE0001I,CWWKS*A,CWWKZ0012E" />

</server>
