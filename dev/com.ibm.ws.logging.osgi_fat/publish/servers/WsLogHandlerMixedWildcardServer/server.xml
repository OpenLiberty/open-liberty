<server description="WsLogHandler FAT Test Server - Mixed Valid and Invalid Wildcard IDs">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- A mix of valid and invalid patterns. Keep in sync with GOOD_PATTERNS and
         BAD_PATTERNS in WsLogHandlerInvalidWildcardTest.

         Valid  : CWLFA* (prefix), CWLFB*W (prefix + level), CWLFC0001I (exact ID)
         Invalid: CWLFD*K (unrecognised level), CWLFE** (multiple asterisks)

         The router must register the valid patterns, and reject each invalid one with CWWKE0710W. -->
    <wsLogHandler routerThing="CWLFA*,CWLFD*K,CWLFB*W,CWLFE**,CWLFC0001I" />

</server>
