<server description="WsLogHandler FAT Test Server - Wildcard IDs">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Configure wildcard message ID patterns using synthetic Liberty-style IDs:
         CWLFA* (prefix), CWLFB*W (prefix+level), CWLFC*A (prefix+level), CWLFD*E (prefix+level) -->
    <wsLogHandler routerThing="CWLFA*,CWLFB*W,CWLFC*A,CWLFD*E" />

</server>
