-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: WsLogHandler FAT Test Bundle
Bundle-Description: FAT test bundle for wildcard WsLogHandler routing; version=${bVersion}
Bundle-SymbolicName: com.ibm.ws.logging.osgi.fat.wsloghandler; singleton:=true

IBM-Web-Extension-Processing-Disabled: true

Web-ContextPath: /wsLogHandler

Import-Package: \
    org.objectweb.asm.*;resolution:=optional, \
    !*.internal.*, \
    *

Export-Package: \
    com.ibm.ws.logging.osgi.fat.wsloghandler

-includeresource: \
    OSGI-INF/metatype=test-bundles/com.ibm.ws.logging.osgi.fat.wsloghandler/resources/OSGI-INF/metatype, \
    OSGI-INF/l10n=test-bundles/com.ibm.ws.logging.osgi.fat.wsloghandler/resources/OSGI-INF/l10n, \
    OSGI-INF/permissions.perm=test-bundles/com.ibm.ws.logging.osgi.fat.wsloghandler/resources/OSGI-INF/permissions.perm, \
    WEB-INF=test-bundles/com.ibm.ws.logging.osgi.fat.wsloghandler/resources/WEB-INF

-dsannotations: \
    com.ibm.ws.logging.osgi.fat.wsloghandler.WsLogHandlerConfigReader, \
    com.ibm.ws.logging.osgi.fat.wsloghandler.WsLogHandlerEndpoint

instrument.disabled: true
