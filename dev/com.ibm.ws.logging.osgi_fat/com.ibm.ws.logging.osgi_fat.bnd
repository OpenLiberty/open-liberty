-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

# Defines the symbolic name for the main FAT runner jar.
# The copyBundles task excludes this jar (it contains line.contains(projectName + '.jar')),
# so only the test-bundle sub-jars are staged to publish/bundles/.
Bundle-SymbolicName: com.ibm.ws.logging.osgi_fat
