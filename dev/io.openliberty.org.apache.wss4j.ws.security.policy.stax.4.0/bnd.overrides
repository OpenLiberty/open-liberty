-include= ~../cnf/resources/bnd/rejar.props
bVersion=4.0.0

Bundle-Name:io.openliberty.org.apache.wss4j.ws.security.policy.stax.4.0
Bundle-SymbolicName: io.openliberty.org.apache.wss4j.ws.security.policy.stax.4.0
Bundle-Description: org.apache.wss4j.wss4j.ws.security.policy.stax; version=4.0.0; Jakarta Enabled

WS-TraceGroup: WSS4J

Export-Package: \
 org.apache.wss4j.policy.stax.*;version=${bVersion}

Import-Package: \
 javax.xml.bind.*, \
 !com.ibm.security.jgss, \
 !com.sun.security.jgss, \
 !org.bouncycastle.asn1.*, \
 org.apache.jcp.xml.dsig.internal.*;version="[2.3.0,5.0.0)",\
 org.apache.xml.security.*;version="[2.3.0,5.0.0)",\
 * 
