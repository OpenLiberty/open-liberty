<server description="MCP Server with Configurable Async Timeout">

  <featureManager>
    <feature>servlet-6.0</feature>
    <feature>cdi-4.0</feature>
    <feature>mcp-1.0</feature>
    <feature>concurrent-3.0</feature>
  </featureManager>
  
  <!-- Application with short async timeout (2 seconds) -->
  <application location="shortTimeoutTest.war">
    <mcp asyncTimeout="2s"/>
  </application>

  <!-- Application with default async timeout (30 seconds) -->
  <application location="defaultTimeoutTest.war">
    <mcp/>
  </application>

  <!-- Application with invalid async timeout — used by InvalidAsyncTimeoutTest -->
  <application location="invalidTimeoutTest.war">
    <mcp asyncTimeout="sheep"/>
  </application>

  <include location="../fatTestPorts.xml" />
  
</server>