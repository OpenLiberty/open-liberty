<server description="Sample Liberty server">

  <featureManager>
    <feature>servlet-6.0</feature>
    <feature>cdi-4.0</feature>
    <feature>mcp-1.0</feature>
    <feature>appSecurity-5.0</feature>
  </featureManager>

  <!-- Apps are deployed dynamically by the stateless auth suite test classes.
       Each app is pre-declared here so that the <mcp stateless="true"/> config
       is applied when the WAR is dropped into the apps/ directory. -->
  <application location="permitAllToolsStateless.war">
    <mcp stateless="true"/>
  </application>

  <application location="denyAllToolsStateless.war">
    <mcp stateless="true"/>
  </application>

  <application location="noClassAnnotationToolsStateless.war">
    <mcp stateless="true"/>
  </application>

  <application location="adminsRoleToolsStateless.war">
    <mcp stateless="true"/>
  </application>

  <include location="../fatTestPorts.xml" />
  
	<basicRegistry id="basic" realm="BasicRealm">
	
	     <user name="testuser" password="testpassword"/>
	     <user name="BobTheAdmin" password="testpassword"/>
		 <user name="noRoleUser" password="testpassword"/>

	     <group name="Admins">
	         <member name="BobTheAdmin"/>
	     </group>
	     
	     <group name="TestUsers">
	         <member name="testuser"/>
	     </group>
	     
	     <group name="AllUsers">
	         <member name="testuser"/>
	         <member name="BobTheAdmin"/>
	     </group>
	     
	</basicRegistry>
  
</server>
