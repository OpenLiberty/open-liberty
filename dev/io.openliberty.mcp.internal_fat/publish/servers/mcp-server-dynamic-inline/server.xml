<server description="Dynamic MCP path: feature and app inline at startup">

  <featureManager>
    <feature>servlet-6.0</feature>
    <feature>cdi-4.0</feature>
    <feature>mcp-1.0</feature>
  </featureManager>

  <logging traceSpecification="*=info:MCP=all:com.ibm.ws.app.manager=all"/>
  <enterpriseApplication location="dynamicMcpPathUpdateTest.ear">
    <mcp path="/dynamic-mcp-updated">
      <info name="ibm-mq-mcp-server" version="1.0.0"/>
    </mcp>
  </enterpriseApplication>

  <include location="../fatTestPorts.xml" />

</server>
