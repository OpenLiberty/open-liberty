    Repeat phase: JPA 3.2 apps on the JPA 4.0 container with Hibernate 8.
    Validates backwards compatibility — JPA 3.2 applications must work on
    a server running persistenceContainer-4.0.

    The JPA 4.0 container feature (persistenceContainer-4.0) is a superset
    of JPA 3.2: it accepts persistence.xml schema version 3.2 and all JPA 3.2
    API calls remain valid. Hibernate 8 implements both JPA 4.0 and is
    backwards-compatible with JPA 3.2 application code.
-->
<server>
    <featureManager>
        <feature>persistenceContainer-4.0</feature>
        <feature>servlet-6.2</feature>
        <feature>jndi-1.0</feature>
        <feature>componenttest-2.0</feature>
    </featureManager>

    <jpa defaultPersistenceProvider="org.hibernate.jpa.HibernatePersistenceProvider"/>

    <library id="HibernateLib">
        <fileset dir="${shared.resource.dir}/jpa_fat_jpa40_hibernate" includes="*.jar"/>
    </library>

    <!-- Java 2 Security: ANTLR runtime requires env-variable access -->
    <javaPermission className="java.lang.RuntimePermission" name="getenv.TURN_OFF_LR_LOOP_ENTRY_BRANCH_OPT"/>

    <!-- START: Hibernate 8 permissions -->
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/antlr4-runtime-4.13.2.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/byte-buddy-1.18.10.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/cache-api-1.1.1.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/ehcache-3.10.8-jakarta.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/hibernate-core-8.0.0.Beta1.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/hibernate-community-dialects-8.0.0.Beta1.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/hibernate-jcache-8.0.0.Beta1.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/hibernate-models-1.2.0.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/hibernate-scan-jandex-8.0.0.Beta1.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/jandex-3.6.0.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/jboss-logging-3.6.3.Final.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/angus-activation-2.0.3.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/istack-commons-runtime-4.1.2.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/jaxb-core-4.0.9.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/jaxb-runtime-4.0.9.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/slf4j-api-1.7.36.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/slf4j-simple-1.7.36.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_fat_jpa40_hibernate/txw2-4.0.9.jar"/>
    <!-- END: Hibernate 8 permissions -->

</server>
