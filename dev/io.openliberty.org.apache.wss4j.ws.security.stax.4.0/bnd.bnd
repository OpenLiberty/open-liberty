-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

wss4jVersion=4.0.0

Bundle-SymbolicName: io.openliberty.org.apache.wss4j.ws.security.stax.4.0

WS-TraceGroup: WSS4J

Bundle-ActivationPolicy: lazy

Export-Package: \
 org.apache.wss4j.stax.*;version=${wss4jVersion}

# Using version=! in order to not have a version attached to the import for packages that were removed
# from Java after Java 8.  Doing this keeps the import like before Java 11 support. It will get the 
# packages from Java when using Java 8 or earlier and from the new shipped bundles for Java 9 and later.
Import-Package: \
 org.glassfish.jaxb.runtime.v2;resolution:=optional,\
 org.apache.xml.security.*;version="[2.3.0,5.0.0)",\
 *

DynamicImport-Package: \
 org.glassfish.jaxb.runtime.v2.*

-includeresource: \
  @${repo;org.apache.wss4j:wss4j-ws-security-stax;${wss4jVersion}}!/!META-INF/MANIFEST.MF|!META-INF/maven/*, \
  org/apache/wss4j/stax=${bin}/org/apache/wss4j/stax

instrument.classesExcludes: org/apache/wss4j/stax/setup/*.class
-buildpath: \
	org.apache.wss4j:wss4j-ws-security-stax;version=${wss4jVersion},\
	io.openliberty.org.apache.wss4j.ws.security.common.4.0;version=latest,\
	com.ibm.ws.org.slf4j.api;version=latest,\
	io.openliberty.org.apache.wss4j.bindings.4.0;version=latest,\
	io.openliberty.org.apache.santuario.xmlsec;version=latest,\
	io.openliberty.jakarta.xmlBinding.4.0;version=latest,\
	io.openliberty.xmlBinding.3.0.internal.tools, \
	com.ibm.ws.org.joda.time.2.9.9;version=latest
