-include= ~../cnf/resources/bnd/bundle.props

Bundle-Name: Model Context Protocol Monitor API
Bundle-SymbolicName: io.openliberty.mcp.monitor
Bundle-Description: Model Context Protocol Monitor API, version ${bVersion}

bVersion=1.0

publish.wlp.jar.suffix: dev/api/ibm

javac.source: 17
javac.target: 17

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=17))"

WS-TraceGroup: MCP

Export-Package: \
    io.openliberty.mcp.monitor

-buildpath: \
    com.ibm.websphere.org.osgi.core;version=latest,\
    com.ibm.ws.org.osgi.annotation.versioning;version=latest,\
    com.ibm.ws.logging;version=latest,\
    com.ibm.websphere.appserver.api.monitor;version=latest
