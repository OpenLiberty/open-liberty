-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0.0

# For more information, see http://was.pok.ibm.com/xwiki/bin/view/Liberty/UsingBnd

Bundle-Name: Test Libraries
Bundle-SymbolicName: test.libraries; singleton:=true
Bundle-Description: This bundle provides a config element and implementation thereof to consume a library to use for testing; version=${bVersion}
Bundle-Activator: test.libraries.Activator

#optional, should match the trace group used by Tr components (see sample package-info.java)
WS-TraceGroup: TestLibraries

# export the interface packages
Export-Package:

Include-Resource: \
   OSGI-INF=test-bundles/test.libraries/OSGI-INF

# hide the implementation packages
Private-Package: \
  test.libraries, \
  test.shared; 


-dsannotations: test.libraries.LibraryUser
