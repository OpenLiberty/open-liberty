<metatype:MetaData xmlns:metatype="http://www.osgi.org/xmlns/metatype/v1.1.0"
                   xmlns:ibm="http://www.ibm.com/xmlns/appservers/osgi/metatype/v1.0.0"
                   xmlns:ibmui="http://www.ibm.com/xmlns/appservers/osgi/metatype/ui/v1.0.0"
                   localization="OSGI-INF/l10n/metatype">
 <!-- Resource Adapter supertype -->

 <Designate factoryPid="com.ibm.ws.jca.resourceAdapter.supertype">
  <Object ocdref="com.ibm.ws.jca.resourceAdapter.supertype" />
 </Designate>

 <OCD
 	id="com.ibm.ws.jca.resourceAdapter.supertype"
 	name="internal"
 	description="internal use only" >
  <AD id="unused"    type="String" required="false"  name="Unused" description="Unused." />
 </OCD>


 <!-- Resource Adapter -->

 <Designate factoryPid="com.ibm.ws.jca.resourceAdapter">
  <Object ocdref="com.ibm.ws.jca.resourceAdapter" />
 </Designate>

 <OCD
 	id="com.ibm.ws.jca.resourceAdapter"
 	ibm:alias="mockResourceAdapter"
 	ibm:extends="com.ibm.ws.jca.resourceAdapter.supertype"
 	name="A mock resource adapter"
 	description="Just a test object" >
  <AD id="classProvider.pid"    type="String" required="true"  name="internal" description="internal use only" default="${service.pid}" />
  <AD id="libraryRef"           type="String" required="true"  name="library"  description="my library" />
  <AD id="library.target"       type="String" required="false" name="internal" description="internal use only" default="(id=${libraryRef})" />
 </OCD>


</metatype:MetaData>
