-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0.0

Bundle-Name: test.library.packages.importer1
Bundle-SymbolicName: test.library.packages.importer1
Bundle-Description: This bundle dynamically imports packages from a library; version=${bVersion}

WS-TraceGroup: TestLibraries

DynamicImport-Package: *

# hide the implementation packages
Private-Package: \
  test.library.packages.importer1


-dsannotations: test.library.packages.importer1.TestImporter
