-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0.0

# For more information, see http://was.pok.ibm.com/xwiki/bin/view/Liberty/UsingBnd

Bundle-Name: Library Listener
Bundle-SymbolicName: library.listener; singleton:=true
Bundle-Description: This bundle provides a library listener for testing; version=${bVersion}

#optional, should match the trace group used by Tr components (see sample package-info.java)
WS-TraceGroup: LibraryListener

# don't need to export any packages
Export-Package:
  
# include the implementation packages
Private-Package: library.*

# use the annotations to describe the services
-dsannotations: library.listener.LibraryTracker