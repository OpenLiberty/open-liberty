<server>
    <featureManager>
        <feature>servlet-6.0</feature>
        <feature>enterpriseBeansLite-4.0</feature>
        <feature>io.openliberty.enterpriseBeansRemote-4.0</feature>
        <feature>localConnector-1.0</feature>
    </featureManager>

    
    <enterpriseApplication id="PLGenStub" name="PLGenStub" location="PLGenStub.ear" >
        <classloader delegation="parentLast"/>             
    </enterpriseApplication>
    
    <javaPermission className="java.lang.RuntimePermission" name="getClassLoader" actions="*"/>    
    <javaPermission className="java.util.PropertyPermission" name="*" actions="read,write"/>
    
    <webContainer deferServletLoad="false"/>

    
    <include location="../fatTestPorts.xml"/>
    
    <keyStore id="defaultKeyStore" password="password"/>
    <basicRegistry id="basic" realm="BasicRealm">
        <user name="bob" password="password"/>
    </basicRegistry>
    <!-- Test to see that stub generation in classloader parentLast delegation is correct -->
</server>
