<server>
    <featureManager>
        <feature>servlet-4.0</feature>
        <!-- User feature that activates the ResourceProvider DS bundles
             required by ClassloaderResourceAndVisibilityFatTest. -->
        <feature>usr:classloadingfat-testbundles-1.0</feature>
        <!-- System test feature that exposes com.ibm.ws.ffdc, com.ibm.ejs.ras,
             etc. as API so ClassloaderResourceAndVisibilityFatTest can verify class visibility rules. -->
        <feature>classloadingfat-testfeature-1.0</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

    <!-- exportAppToServer writes to the server's apps/ directory; an explicit
         webApplication element is required for Liberty to load the WAR. -->
    <webApplication location="loaderApp.war" contextRoot="loaderApp"/>
</server>
