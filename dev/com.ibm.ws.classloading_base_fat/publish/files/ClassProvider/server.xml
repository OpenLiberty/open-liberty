<server>
    <featureManager>
        <feature>servlet-6.0</feature>
        <feature>mock.jca-1.0</feature>
        <feature>classloadingfatlibertyinternals-1.0</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

    <application type="war" id="sharedLib1" name="sharedLib1" location="sharedLib.war">
        <classloader privateLibraryRef="AppSharedLibraryA, AppSharedLibraryB, AppSharedLibraryC" />
    </application>

    <application type="war" id="sharedLib2" name="sharedLib2" location="sharedLib.war">
        <classloader privateLibraryRef="AppSharedLibraryA, AppSharedLibraryB, AppSharedLibraryC" />
    </application>

    <application type="war" id="sharedLib3" name="sharedLib3" location="sharedLib.war">
        <classloader classProviderRef="ra1, ra2" />
    </application>

    <application type="war" id="sharedLib4" name="sharedLib4" location="sharedLib.war">
        <classloader classProviderRef="ra1, ra2, ra3" />
    </application>

    <application type="war" id="sharedLib5" name="sharedLib5" location="sharedLib.war">
        <classloader privateLibraryRef="AppSharedLibraryA" classProviderRef="ra2" />
    </application>

    <library id="AppSharedLibraryA">
        <fileset dir="${server.config.dir}/SharedLibraryA" includes="*.jar" scanInterval="5s"/>
    </library>

    <library id="AppSharedLibraryB">
        <fileset dir="${server.config.dir}/SharedLibraryB" includes="*.jar" scanInterval="5s"/>
    </library>

    <library id="AppSharedLibraryC">
        <fileset dir="${server.config.dir}/SharedLibraryC" includes="*.jar" scanInterval="5s"/>
    </library>

    <mockResourceAdapter id="ra1" libraryRef="AppSharedLibraryA" />
    <mockResourceAdapter id="ra2" libraryRef="AppSharedLibraryB" />
    <mockResourceAdapter id="ra3" libraryRef="AppSharedLibraryC" />
</server>
