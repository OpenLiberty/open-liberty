<server>
    <include location="../fatTestPorts.xml"/>

    <featureManager>
        <feature>test.library.packages-1.0</feature>
        <feature>usr:user.test.library.packages-1.0</feature>
    </featureManager>

    <library id="testLibPackages">
        <fileset dir="${server.config.dir}/lib" includes="*.jar" />
    </library>

    <libraryPackageUser libraryRef="testLibPackages">
       <package>test.library.packages.exporter1</package>
       <package>test.library.packages.exporter2</package>
    </libraryPackageUser>

    <logging traceSpecification="LogService=all:com.ibm.ws.config*=all" />
</server>
