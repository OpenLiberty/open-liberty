<server description="new server">

    <!-- Enable features -->
    <featureManager>
        <feature>pages-3.1</feature>
        <feature>enterpriseBeansLite-4.0</feature>
        <feature>restConnector-2.0</feature>
    </featureManager>

    <include location="../fatTestPorts.xml"/>

    <quickStartSecurity userName="theUser" userPassword="thePassword"/>
    
    <keyStore id="defaultKeyStore" password="Liberty"/>
    
    <applicationMonitor updateTrigger="mbean"/>

    <enterpriseApplication id="updateableApp"
        location="updateableApp.ear.xml" name="updateableApp">
    </enterpriseApplication>

    <logging traceSpecification="*=info:com.ibm.ws.classloading.internal.util.ClassRedefiner=all:com.ibm.ws.app.manager.internal.monitor.*=all:com.ibm.ws.classloading.internal.*=all"/>

</server>