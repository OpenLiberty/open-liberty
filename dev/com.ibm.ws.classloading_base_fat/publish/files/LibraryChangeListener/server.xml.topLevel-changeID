<server>
    <include location="../fatTestPorts.xml"/>

    <featureManager>
        <feature>servlet-6.0</feature>
        <feature>jdbc-4.3</feature>
        <feature>localConnector-1.0</feature>
        <feature>library.listener-1.0</feature>
    </featureManager>
<dataSource id="dataSource" jndiName="jdbc/DictionaryDB" supplementalJDBCTrace="true">
        <properties.derby.embedded createDatabase="create" databaseName="${server.config.dir}/dictionaryDB"/>
        <jdbcDriver libraryRef="myLib2" />
    </dataSource>
    
    <library id="myLib2">
        <fileset dir="${server.config.dir}/SharedLibraryA" includes="*.jar" />
    </library>

    <logging traceSpecification="LogService=all:com.ibm.ws.library.*=all:com.ibm.ws.classloading.*=all" maxFileSize="0"/>
</server>