-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0.0

Bundle-Name: Mock JCA Resource Adapter
Bundle-SymbolicName: mock.jca; singleton:=true
Bundle-Description: This bundle provides a mock resource adapter to use for testing; version=${bVersion}

WS-TraceGroup: MockJCA

# don't need to export any packages
Export-Package:

# include the implementation packages
Private-Package: mock.*

# add the OSGI-INF stuff into the bundle
Include-Resource: OSGI-INF=test-bundles/mock.jca/resources/OSGI-INF

# use the annotations to describe the services
-dsannotations: mock.jca.ResourceAdapter
