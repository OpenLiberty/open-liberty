-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0.0

Bundle-Name: test.library.packages
Bundle-SymbolicName: test.library.packages
Bundle-Description: This bundle provides configuration for testing library packages; version=${bVersion}
Bundle-Activator: test.library.packages.Activator

WS-TraceGroup: TestLibraries

# export the interface packages
Export-Package:

Include-Resource: \
   OSGI-INF=test-bundles/test.library.packages/OSGI-INF

# hide the implementation packages
Private-Package: \
  test.library.packages


-dsannotations: test.library.packages.LibraryPackageUser
