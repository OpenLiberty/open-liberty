-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: Class Loading FAT Test Bundle B
Bundle-SymbolicName: test.classloading.bvt.bundle.b; singleton:=true
Bundle-Activator: io.openliberty.classloading.bvt.bundle.b.Activator

Private-Package: io.openliberty.classloading.bvt.bundle.b

# com.ibm.wsspi.classloading is referenced in the DS component XML
# (implementation class="com.ibm.wsspi.classloading.ResourceProvider").
# BND does not scan XML for imports so we declare it explicitly.
Import-Package: com.ibm.wsspi.classloading, \
  org.osgi.framework;version="[1.10,2)"

Include-Resource: test-bundles/bundleB/resources/

Service-Component: OSGI-INF/test.classloading.bvt.bundle.b.ResourceProvider.xml
