-include= ~../cnf/resources/bnd/rejar.props
bVersion=4.0.0

Bundle-ActivationPolicy: lazy

WS-TraceGroup: WSS4J

Export-Package: \
 org.apache.wss4j.binding.*;version=${bVersion}

Import-Package: \
 org.apache.jcp.xml.dsig.internal.*;version="[2.3.0,5.0.0)",\
 org.apache.xml.security.*;version="[2.3.0,5.0.0)",\
 *