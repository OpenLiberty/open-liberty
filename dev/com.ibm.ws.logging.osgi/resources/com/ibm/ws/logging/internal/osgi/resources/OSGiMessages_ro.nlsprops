# 0700 - 0799 com.ibm.ws.logging.internal.osgi.resouces.OSGiMessages -- OSGi Framework/kernel diagnostics
# -------------------------------------------------------------------------------------------------

# OSGI Log Message
OSGI_MSG001=CWWKE0703I: {0} {1} {2} {3}
OSGI_MSG001.explanation=Un mesaj informativ a fost \u00eenregistrat \u00een istoric cu serviciul de jurnalizare OSGi.
OSGI_MSG001.useraction=Nici o ac\u0163iune nu este necesar\u0103.

OSGI_AUDIT_MSG=CWWKE0704A: {0} {1} {2} {3}
OSGI_AUDIT_MSG.explanation=Un mesaj de auditare a fost \u00eenregistrat \u00een istoric cu serviciul de jurnalizare OSGi.
OSGI_AUDIT_MSG.useraction=Nu este necesar\u0103 nicio ac\u0163iune.

OSGI_WARNING_MSG=CWWKE0700W: {0} {1} {2} {3}
OSGI_WARNING_MSG.explanation=Un mesaj de avertisment a fost \u00eenregistrat \u00een istoric folosind serviciul de istoric OSGi.
OSGI_WARNING_MSG.useraction=Consulta\u0163i mesajul de avertisment pentru informa\u0163ii.

OSGI_ERROR_MSG=CWWKE0701E: {0} {1} {2} {3}
OSGI_ERROR_MSG.explanation=Un mesaj de eroare a fost \u00eenregistrat \u00een istoric folosind serviciul de istoric OSGi.
OSGI_ERROR_MSG.useraction=Consulta\u0163i mesajul de eroare pentru informa\u0163ii.

OSGI_BUNDLE_EXCEPTION=CWWKE0702E: {0}
OSGI_BUNDLE_EXCEPTION.explanation=S-a aruncat o BundleException de c\u0103tre Cadrul de lucru OSGi.
OSGI_BUNDLE_EXCEPTION.useraction=Consulta\u0163i mesajul excep\u0163iei pentru informa\u0163ii.

MESSAGE.ROUTER.INVALID.WILDCARD.MESSAGE.ID.CWWKE0710W=CWWKE0710W: ID-ul mesajului cu caracter wildcard pentru {0} nu este valid. Sintaxa a\u0219teptat\u0103 este <prefix>*[<nivel-jurnal]], unde \u201enivel-jurnal\u201d este un singur caracter op\u021bional care reprezint\u0103 unul dintre urm\u0103toarele niveluri de jurnal: I pentru informa\u021bii, A pentru audit, W pentru avertisment sau E pentru eroare.
MESSAGE.ROUTER.INVALID.WILDCARD.MESSAGE.ID.CWWKE0710W.explanation=Un ID de mesaj care con\u021bine un caracter joker nu respect\u0103 sintaxa a\u0219teptat\u0103. Sintaxa a\u0219teptat\u0103 este <prefix>*[<nivel-jurnal>]. Valoarea nivelului de jurnal este un singur caracter op\u021bional care reprezint\u0103 nivelul de jurnal \u201eInforma\u021bii\u201d, \u201eAudit\u201d, \u201eAvertisment\u201d sau \u201eEroare\u201d.
MESSAGE.ROUTER.INVALID.WILDCARD.MESSAGE.ID.CWWKE0710W.useraction=Actualiza\u021bi ID-ul mesajului astfel \u00eenc\u00e2t s\u0103 respecte sintaxa prev\u0103zut\u0103: <prefix>*[<nivel de jurnal]]. Specifica\u021bi un caracter valid: I pentru informa\u021bii, A pentru audit, W pentru avertisment, E pentru eroare sau omite\u021bi valoarea nivelului de jurnalizare. Dac\u0103 nu \u00eentreprinde\u021bi nicio ac\u021biune, acest ID de mesaj va fi ignorat, iar mesajele corespunz\u0103toare nu vor fi \u00eenregistrate.
