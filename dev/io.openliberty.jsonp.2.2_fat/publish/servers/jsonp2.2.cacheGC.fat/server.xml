<server>
    <featureManager>
        <feature>componenttest-2.0</feature>
        <feature>servlet-6.2</feature>
        <feature>jsonp-2.2</feature>
    </featureManager>

    <!-- gcTestLib is loaded by a single shared classloader that is parent to both WARs.
         ClassLoaderRef's static field therefore has one identity across all applications. -->
    <library id="gcTestLib">
        <file name="${shared.resource.dir}/gcTestLib/gcTestLib.jar"/>
    </library>

    <application location="CacheCheckerApp.war">
        <classloader commonLibraryRef="gcTestLib"/>
    </application>

    <!-- BundledProviderApp is exported to apps/ by setUp() and deleted mid-test -->
    <application location="BundledProviderApp.war">
        <classloader commonLibraryRef="gcTestLib"/>
    </application>

    <include location="../fatTestPorts.xml"/>
</server>
