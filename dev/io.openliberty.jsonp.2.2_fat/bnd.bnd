-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

# TODO: Reset to 17 once eeCompatible-12.0 constraint is resolved
javac.source: 21
javac.target: 21

src: \
	fat/src,\
	test-applications/CustomProviderApp/src

fat.project: true

tested.features: \
    servlet-6.2

# To define a global minimum java level for the FAT, use the following property.
# If unspecified, the default value is ${javac.source}
# TODO: Reset to 17 once eeCompatible-12.0 constraint is resolved
fat.minimum.java.level: 21

-buildpath: \
        com.ibm.ws.componenttest.2.0;version=latest,\
	io.openliberty.jakarta.jsonp.2.2;version=latest,\
	io.openliberty.jakarta.servlet.6.0;version=latest
