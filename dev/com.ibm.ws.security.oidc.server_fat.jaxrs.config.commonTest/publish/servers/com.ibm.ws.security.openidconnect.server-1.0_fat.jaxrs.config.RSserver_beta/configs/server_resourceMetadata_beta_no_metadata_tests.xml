<!--
    RS server configuration for NoOPResourceMetadataBetaNoMetadataRSServerTests.

    This config is used with the RSserver_beta server whose jvm.options carries
    -Dcom.ibm.ws.beta.edition=true.  However, the openidConnectClient imported by
    oidcClient_RSResourceMetadata_noConfig.xml deliberately omits the
    <protectedResourceMetadata> sub-element.

    Expected behaviour: even though the beta flag is on, the WWW-Authenticate 401
    response MUST NOT contain the resource_metadata parameter because the element
    is not configured.
 -->
<server>
    <include location="${server.config.dir}/imports/oidcClientFeatures.xml" />
    <include location="${server.config.dir}/imports/BasicRegistry.xml" />
    <include location="${server.config.dir}/imports/goodSSLSettings.xml" />
    <include location="${server.config.dir}/imports/misc.xml" />
    <include location="${server.config.dir}/imports/oidcClient_RSResourceMetadata_noConfig.xml" />
    <include location="${server.config.dir}/imports/helloworldApplication.xml" />
</server>
