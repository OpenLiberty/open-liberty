#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO 
#
# NLS_MESSAGEFORMAT_VAR
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat 
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 

# Message prefix block: CWWKO1350 - CWWKO1399

OSGI_SERVICE_ERROR=CWWKO1350E: Der OSGi-Service {0} ist nicht verf\u00fcgbar.
OSGI_SERVICE_ERROR.explanation=Dieser interne Serverfehler wird ausgel\u00f6st, weil der angegebene Service nicht verf\u00fcgbar ist.
OSGI_SERVICE_ERROR.useraction=Starten Sie den Server mit der Option clean erneut.

CORS_UNSUPPORTED_ORIGIN_WILDCARD=CWWKO1351W: Der Wert \u201e allowedOrigins \u201c {0} in der CORS -Konfiguration f\u00fcr die Dom\u00e4ne {1} enth\u00e4lt einen nicht unterst\u00fctzten Platzhalter und wird ignoriert. Nur der Wert * l\u00e4sst alle Urspr\u00fcnge zu.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.explanation=Das Attribut \u201e allowedOrigins \u201c akzeptiert entweder ein einzelnes Sternchen (*), um alle Urspr\u00fcnge zuzulassen, oder eine Liste mit genauen Urspr\u00fcngen. Ein Ursprung, der ein Sternchen zusammen mit anderen Zeichen enth\u00e4lt, ist kein unterst\u00fctztes Muster; daher wird er ignoriert und l\u00e4sst keinen Ursprung zu.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.useraction=Geben Sie jede zul\u00e4ssige Quelle explizit an oder verwenden Sie *, um alle Quellen zuzulassen.
