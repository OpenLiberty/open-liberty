#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO 
#
# NLS_MESSAGEFORMAT_VAR
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat 
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 

# Message prefix block: CWWKO1350 - CWWKO1399

OSGI_SERVICE_ERROR=CWWKO1350E: Us\u0142uga OSGi {0} nie jest dost\u0119pna.
OSGI_SERVICE_ERROR.explanation=Jest to wewn\u0119trzny b\u0142\u0105d serwera zg\u0142aszany w zwi\u0105zku z niedost\u0119pno\u015bci\u0105 okre\u015blonej us\u0142ugi.
OSGI_SERVICE_ERROR.useraction=Zrestartuj serwer, u\u017cywaj\u0105c opcji clean.

CORS_UNSUPPORTED_ORIGIN_WILDCARD=CWWKO1351W: Warto\u015b\u0107 allowedOrigins {0} w konfiguracji CORS dla domeny {1} zawiera nieobs\u0142ugiwany symbol wieloznaczny i jest ignorowana. Tylko warto\u015b\u0107 * zezwala na wszystkie \u017ar\u00f3d\u0142a.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.explanation=Atrybut \u201e allowedOrigins \u201d mo\u017ce przyjmowa\u0107 albo pojedyncz\u0105 gwiazdk\u0119 (*), kt\u00f3ra zezwala na wszystkie \u017ar\u00f3d\u0142a, albo list\u0119 konkretnych \u017ar\u00f3de\u0142. Pochodzenie zawieraj\u0105ce gwiazdk\u0119 wraz z innymi znakami nie jest obs\u0142ugiwanym wzorcem, dlatego jest ignorowane i nie zezwala na \u017cadne pochodzenie.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.useraction=Nale\u017cy wyra\u017anie okre\u015bli\u0107 ka\u017cde dozwolone \u017ar\u00f3d\u0142o lub wpisa\u0107 znak *, aby zezwoli\u0107 na wszystkie \u017ar\u00f3d\u0142a.
