#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO 
#
# NLS_MESSAGEFORMAT_VAR
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat 
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 

# Message prefix block: CWWKO1350 - CWWKO1399

OSGI_SERVICE_ERROR=CWWKO1350E: Le service OSGi {0} n''est pas disponible.
OSGI_SERVICE_ERROR.explanation=Cette erreur de serveur interne est \u00e9mise car le service sp\u00e9cifi\u00e9 n'est pas disponible.
OSGI_SERVICE_ERROR.useraction=Red\u00e9marrez le serveur en utilisant l'option clean.

CORS_UNSUPPORTED_ORIGIN_WILDCARD=CWWKO1351W: La valeur \u00ab allowedOrigins \u00bb {0} de la configuration CORS pour le domaine {1} contient un caract\u00e8re g\u00e9n\u00e9rique non pris en charge et est ignor\u00e9e. Seule la valeur * autorise toutes les origines.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.explanation=L'attribut \u00ab allowedOrigins \u00bb accepte soit un seul ast\u00e9risque (*) pour autoriser toutes les origines, soit une liste d'origines pr\u00e9cises. Une origine contenant un ast\u00e9risque associ\u00e9 \u00e0 d'autres caract\u00e8res n'est pas un motif pris en charge; elle est donc ignor\u00e9e et n'autorise aucune origine.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.useraction=Indiquez explicitement chaque origine autoris\u00e9e, ou utilisez le caract\u00e8re * pour autoriser toutes les origines.
