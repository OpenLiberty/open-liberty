#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO 
#
# NLS_MESSAGEFORMAT_VAR
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat 
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 

# Message prefix block: CWWKO1350 - CWWKO1399

OSGI_SERVICE_ERROR=CWWKO1350E: O servi\u00e7o OSGi {0} n\u00e3o est\u00e1 dispon\u00edvel.
OSGI_SERVICE_ERROR.explanation=Esse erro do servidor interno \u00e9 lan\u00e7ado porque o servi\u00e7o especificado n\u00e3o est\u00e1 dispon\u00edvel.
OSGI_SERVICE_ERROR.useraction=Reinicie o servidor com a op\u00e7\u00e3o de limpeza.

CORS_UNSUPPORTED_ORIGIN_WILDCARD=CWWKO1351W: O valor allowedOrigins {0} na configura\u00e7\u00e3o CORS para o dom\u00ednio {1} cont\u00e9m um curinga n\u00e3o suportado e \u00e9 ignorado. Somente o valor * permite todas as origens.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.explanation=O atributo ` allowedOrigins ` aceita um \u00fanico asterisco (*) para permitir todas as origens ou uma lista de origens espec\u00edficas. Uma origem que contenha um asterisco junto com outros caracteres n\u00e3o \u00e9 um padr\u00e3o compat\u00edvel; portanto, ela \u00e9 ignorada e n\u00e3o permite nenhuma origem.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.useraction=Especifique explicitamente cada origem permitida ou use * para permitir todas as origens.
