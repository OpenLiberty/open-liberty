#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO 
#
# NLS_MESSAGEFORMAT_VAR
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat 
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 

# Message prefix block: CWWKO1350 - CWWKO1399

OSGI_SERVICE_ERROR=CWWKO1350E: OSGi \u670d\u52d9 {0} \u7121\u6cd5\u4f7f\u7528\u3002
OSGI_SERVICE_ERROR.explanation=\u56e0\u70ba\u6307\u5b9a\u7684\u670d\u52d9\u7121\u6cd5\u4f7f\u7528\uff0c\u64f2\u51fa\u4e86\u9019\u500b\u5167\u90e8\u4f3a\u670d\u5668\u932f\u8aa4\u3002
OSGI_SERVICE_ERROR.useraction=\u8acb\u4ee5 clean \u9078\u9805\u91cd\u65b0\u555f\u52d5\u4f3a\u670d\u5668\u3002

CORS_UNSUPPORTED_ORIGIN_WILDCARD=CWWKO1351W: \u7db2\u57df {1} \u7684 CORS \u8a2d\u5b9a\u4e2d\uff0c allowedOrigins \u503c {0} \u5305\u542b\u4e0d\u652f\u63f4\u7684\u842c\u7528\u5b57\u5143\uff0c\u56e0\u6b64\u5c07\u88ab\u5ffd\u7565\u3002 \u53ea\u6709\u7576\u503c\u8a2d\u70ba * \u6642\uff0c\u624d\u6703\u5141\u8a31\u6240\u6709\u8d77\u9ede\u3002
CORS_UNSUPPORTED_ORIGIN_WILDCARD.explanation=allowedOrigins \u5c6c\u6027\u53ef\u63a5\u53d7\u55ae\u4e00\u661f\u865f (*) \u4ee5\u5141\u8a31\u6240\u6709\u4f86\u6e90\uff0c\u6216\u4e00\u7d44\u78ba\u5207\u7684\u4f86\u6e90\u6e05\u55ae\u3002 \u82e5\u4f86\u6e90\u5305\u542b\u661f\u865f\u53ca\u5176\u4ed6\u5b57\u5143\uff0c\u5247\u4e0d\u5c6c\u65bc\u53d7\u652f\u63f4\u7684\u6a21\u5f0f\uff0c\u56e0\u6b64\u6703\u88ab\u5ffd\u7565\uff0c\u4e14\u4e0d\u5141\u8a31\u4efb\u4f55\u4f86\u6e90\u3002
CORS_UNSUPPORTED_ORIGIN_WILDCARD.useraction=\u8acb\u660e\u78ba\u6307\u5b9a\u6bcf\u500b\u5141\u8a31\u7684\u4f86\u6e90\uff0c\u6216\u6307\u5b9a * \u4ee5\u5141\u8a31\u6240\u6709\u4f86\u6e90\u3002
