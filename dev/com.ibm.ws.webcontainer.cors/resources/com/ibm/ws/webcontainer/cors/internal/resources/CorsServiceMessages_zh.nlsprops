#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO 
#
# NLS_MESSAGEFORMAT_VAR
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat 
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 

# Message prefix block: CWWKO1350 - CWWKO1399

OSGI_SERVICE_ERROR=CWWKO1350E: OSGi \u670d\u52a1 {0} \u4e0d\u53ef\u7528\u3002
OSGI_SERVICE_ERROR.explanation=\u629b\u51fa\u6b64\u5185\u90e8\u670d\u52a1\u5668\u9519\u8bef\u662f\u56e0\u4e3a\u6307\u5b9a\u7684\u670d\u52a1\u4e0d\u53ef\u7528\u3002
OSGI_SERVICE_ERROR.useraction=\u8bf7\u4f7f\u7528 clean \u9009\u9879\u91cd\u65b0\u542f\u52a8\u670d\u52a1\u5668\u3002

CORS_UNSUPPORTED_ORIGIN_WILDCARD=CWWKO1351W: \u57df {1} \u7684 CORS \u914d\u7f6e\u4e2d\uff0c allowedOrigins \u503c {0} \u5305\u542b\u4e00\u4e2a\u4e0d\u53d7\u652f\u6301\u7684\u901a\u914d\u7b26\uff0c\u56e0\u6b64\u88ab\u5ffd\u7565\u3002 \u53ea\u6709\u5f53\u503c\u4e3a * \u65f6\uff0c\u624d\u5141\u8bb8\u6240\u6709\u8d77\u59cb\u70b9\u3002
CORS_UNSUPPORTED_ORIGIN_WILDCARD.explanation=allowedOrigins \u5c5e\u6027\u53ef\u4ee5\u63a5\u53d7\u5355\u4e2a\u661f\u53f7 (*) \u4ee5\u5141\u8bb8\u6240\u6709\u6765\u6e90\uff0c\u4e5f\u53ef\u4ee5\u63a5\u53d7\u4e00\u7ec4\u786e\u5207\u7684\u6765\u6e90\u5217\u8868\u3002 \u5305\u542b\u661f\u53f7\u53ca\u5176\u4ed6\u5b57\u7b26\u7684\u6e90\u5730\u5740\u4e0d\u5c5e\u4e8e\u53d7\u652f\u6301\u7684\u6a21\u5f0f\uff0c\u56e0\u6b64\u4f1a\u88ab\u5ffd\u7565\uff0c\u4e14\u4e0d\u5141\u8bb8\u4efb\u4f55\u6e90\u5730\u5740\u3002
CORS_UNSUPPORTED_ORIGIN_WILDCARD.useraction=\u8bf7\u660e\u786e\u6307\u5b9a\u6bcf\u4e2a\u5141\u8bb8\u7684\u6765\u6e90\uff0c\u6216\u6307\u5b9a * \u4ee5\u5141\u8bb8\u6240\u6709\u6765\u6e90\u3002
