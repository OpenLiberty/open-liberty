#ISMESSAGEFILE TRUE
#NLS_ENCODING=UNICODE
#
#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO 
#
# NLS_MESSAGEFORMAT_VAR
#
#   Strings in this file which contain replacement variables are processed by the MessageFormat 
#   class (single quote must be coded as 2 consecutive single quotes ''). Strings in this file 
#   which do NOT contain replacement variables are NOT processed by the MessageFormat class 
#   (single quote must be coded as one single quote '). 

# Message prefix block: CWWKO1350 - CWWKO1399

OSGI_SERVICE_ERROR=CWWKO1350E: El servicio OSGi {0} no est\u00e1 disponible.
OSGI_SERVICE_ERROR.explanation=Este error interno del servidor se genera porque el servicio especificado no est\u00e1 disponible.
OSGI_SERVICE_ERROR.useraction=Reinicie el servidor con la opci\u00f3n clean.

CORS_UNSUPPORTED_ORIGIN_WILDCARD=CWWKO1351W: El valor \u00ab allowedOrigins \u00bb {0} de la configuraci\u00f3n de CORS para el dominio {1} contiene un comod\u00edn no admitido y, por lo tanto, se ignora. Solo el valor * permite todos los or\u00edgenes.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.explanation=El atributo \u00ab allowedOrigins \u00bb admite un \u00fanico asterisco (*) para permitir todos los or\u00edgenes, o bien una lista de or\u00edgenes concretos. Un origen que contenga un asterisco junto con otros caracteres no es un patr\u00f3n v\u00e1lido, por lo que se ignora y no permite ning\u00fan origen.
CORS_UNSUPPORTED_ORIGIN_WILDCARD.useraction=Especifica expl\u00edcitamente cada origen permitido, o utiliza * para permitir todos los or\u00edgenes.
