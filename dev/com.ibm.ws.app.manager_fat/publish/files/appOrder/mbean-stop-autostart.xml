<?xml version="1.0" encoding="UTF-8"?>
<!--
  Server configuration for the stop() regression tests
  (testStopAutoStartTrueAppStaysStopped and
  testStoppedAutoStartTrueAppStaysStoppedAcrossConfigUpdate).

  The "snoop" application uses the default autoStart (true).
-->
<server description="mbean stop autoStart=true test">

    <featureManager>
        <feature>servlet-4.0</feature>
        <feature>localConnector-1.0</feature>
    </featureManager>

    <applicationManager autoExpand="true"/>

    <application id="snoop" name="snoop" location="snoop.war"/>

    <include location="../fatTestPorts.xml"/>
</server>
