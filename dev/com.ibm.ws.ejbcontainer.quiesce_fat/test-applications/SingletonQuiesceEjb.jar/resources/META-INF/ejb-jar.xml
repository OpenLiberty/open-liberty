<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/ejb-jar_3_2.xsd"
         version="3.2">
    <enterprise-beans>
        <session>
            <ejb-name>SingletonQuiesceDD</ejb-name>
            <env-entry>
                <env-entry-name>io.openliberty.ejb.destroyOnQuiesce</env-entry-name>
                <env-entry-type>java.lang.Boolean</env-entry-type>
                <env-entry-value>true</env-entry-value>
            </env-entry>
        </session>
        <session>
            <ejb-name>StartupSingletonQuiesceDD</ejb-name>
            <env-entry>
                <env-entry-name>io.openliberty.ejb.destroyOnQuiesce</env-entry-name>
                <env-entry-type>java.lang.Boolean</env-entry-type>
                <env-entry-value>true</env-entry-value>
            </env-entry>
        </session>
        <session>
            <ejb-name>SingletonQuiesceBndOverride</ejb-name>
            <env-entry>
                <env-entry-name>io.openliberty.ejb.destroyOnQuiesce</env-entry-name>
                <env-entry-type>java.lang.Boolean</env-entry-type>
                <env-entry-value>false</env-entry-value>
            </env-entry>
        </session>
        <session>
            <ejb-name>StartupSingletonQuiesceBndOverride</ejb-name>
            <env-entry>
                <env-entry-name>io.openliberty.ejb.destroyOnQuiesce</env-entry-name>
                <env-entry-type>java.lang.Boolean</env-entry-type>
                <env-entry-value>true</env-entry-value>
            </env-entry>
        </session>
        <session>
            <ejb-name>SingletonQuiesceServerOverride</ejb-name>
            <env-entry>
                <env-entry-name>io.openliberty.ejb.destroyOnQuiesce</env-entry-name>
                <env-entry-type>java.lang.Boolean</env-entry-type>
                <env-entry-value>true</env-entry-value>
            </env-entry>
        </session>
    </enterprise-beans>
</ejb-jar>
