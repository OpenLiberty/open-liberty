<server description="com.ibm.ws.security.token.ltpa.fat.refresh - Short Token Expiration Test Configuration">

    <featureManager>
        <feature>appSecurity-2.0</feature>
        <feature>jsp-2.3</feature>
        <feature>servlet-3.1</feature>
        <feature>ltpafattestlibertyinternals-1.0</feature>
    </featureManager>

    <keyStore id="defaultKeyStore" password="{xor}EzY9Oi0rJg==" /> <!-- pwd: Liberty -->

    <!-- Automatically expand WAR files and EAR files -->
    <applicationManager autoExpand="true"/>

    <basicRegistry id="basic" realm="BasicRealm">
        <user name="user1" password="user1pwd" />
        <user name="user2" password="user2pwd" />
        <group name="group1">
            <member name="user1"/>
        </group>
        <group name="group2">
            <member name="user2"/>
        </group>
    </basicRegistry>

    <application type="war" id="ltpaTest" name="ltpaTest" location="${server.config.dir}/apps/ltpaTest.war">
        <application-bnd>
            <security-role name="Employee">
                <user name="user1" />
                <group name="group1" />
            </security-role>
            <security-role name="Manager">
                <user name="user2" />
                <group name="group2" />
            </security-role>        
            <security-role name="AllAuthenticated">
                <special-subject type="ALL_AUTHENTICATED_USERS" />
            </security-role>
        </application-bnd>
    </application>

    <authentication id="Basic" cacheEnabled="true" />
    
    <httpSession securityIntegrationEnabled="false"/>

    <!-- LTPA configuration for short expiration testing
         - expiration:        3 minutes  absolute token lifetime (hard cap)
         - inactivityTimeout: 2 minutes  token expires if idle longer than this (< expiration)
         - refreshThreshold:  1 minute   proactively refresh when <=1m inactivity time remaining
         NOTE: inactivityTimeout must be strictly less than expiration so the sliding
               window is active. Setting them equal would silently disable sliding behaviour.
    -->
    <ltpa expiration="3m"
          inactivityTimeout="2m"
          refreshThreshold="1m"
          keysFileName="${server.config.dir}/resources/security/ltpa.keys"
          keysPassword="{xor}Lz4sLCgwLTs="/>

    <include location="../fatTestPorts.xml" />
    
    <javaPermission className="javax.security.auth.AuthPermission" name="createLoginContext.system.WEB_INBOUND"/>
    <javaPermission className="javax.security.auth.AuthPermission" name="wssecurity.getCallerSubject"/>
    <javaPermission className="javax.security.auth.AuthPermission" name="wssecurity.getRunAsSubject"/>
    <javaPermission className="javax.security.auth.PrivateCredentialPermission" signedBy="com.ibm.ws.security.token.internal.SingleSignonTokenImpl" principalType="com.ibm.ws.security.authentication.principals.WSPrincipal" principalName="*" actions="read"/>

    <!-- Default SSL configuration enables trust for default certificates from the Java runtime --> 
    <ssl id="defaultSSLConfig" />
    
</server>

