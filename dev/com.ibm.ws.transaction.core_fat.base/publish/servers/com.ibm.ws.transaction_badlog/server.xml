<server>
    <include location="../fatTestPorts.xml"/>

    <featureManager>
      <feature>servlet-3.1</feature>
      <feature>componentTest-1.0</feature>
      <feature>txtest-1.0</feature>
      <feature>osgiconsole-1.0</feature>
      <feature>jndi-1.0</feature>
      <feature>ejb-3.2</feature>
    </featureManager>

    <!--
         transactionLogDirectory is intentionally not set here.
         BadLogTest.beforeClass() always sets it at runtime to a
         dynamically-created unwritable directory so that the recovery
         log open fails and 2PC is disabled.  Any hardcoded path here
         would be overwritten before the server starts.
    -->
    <transaction
        recoverOnStartup="true"
        waitForRecovery="true"
    />

    <application location="transaction.war"/>
</server>

