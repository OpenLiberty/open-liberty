<server description="JPA 4.0 Jakarta Persistence server">

    <include location="../fatTestPorts.xml"/>
    <!--
        The repeat phase config snippet is included at runtime.
        Resolves to hibernate40-cfg.xml (persistenceContainer-4.0 + Hibernate 8, LITE).
    -->
    <include location="${shared.config.dir}/${env.repeat_phase}"/>

    <dataSource id="DefaultDataSource" fat.modify="true">
        <jdbcDriver libraryRef="JDBCLib"/>
        <properties.derby.embedded databaseName="memory:ds1" createDatabase="create"
                                   user="dbuser1" password="{xor}Oz0vKDtu"/>
    </dataSource>

    <library id="JDBCLib">
        <fileset dir="${shared.resource.dir}/jdbc" includes="${env.DB_DRIVER}"/>
    </library>

</server>
