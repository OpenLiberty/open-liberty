<metatype:MetaData xmlns:metatype="http://www.osgi.org/xmlns/metatype/v1.1.0"
                   xmlns:ibm="http://www.ibm.com/xmlns/appservers/osgi/metatype/v1.0.0"
                   localization="OSGI-INF/l10n/metatype">

    <OCD name="%ejbTiming.name" description="%ejbTiming.desc"
         id="com.ibm.ws.request.timing.ejb.metatype"
         ibm:parentPid="com.ibm.ws.request.timing.RequestTimingService"
         ibm:childAlias="ejbTiming">

        <AD id="requestType" name="%requestType.name" description="%requestType.desc"
            required="false" type="String" default="*">
            <Option label="%requestType.option.all"    value="*"/>
            <Option label="%requestType.option.async"  value="async"/>
            <Option label="%requestType.option.mdb"    value="mdb"/>
            <Option label="%requestType.option.remote" value="remote"/>
            <Option label="%requestType.option.timer"  value="timer"/>
        </AD>

        <AD id="appName"    name="%appName.name"    description="%appName.desc"
            required="false" type="String"/>

        <AD id="moduleName" name="%moduleName.name" description="%moduleName.desc"
            required="false" type="String"/>

        <AD id="beanName"   name="%beanName.name"   description="%beanName.desc"
            required="false" type="String"/>

        <AD id="methodName" name="%methodName.name" description="%methodName.desc"
            required="false" type="String"/>

        <AD id="slowRequestThreshold" name="%slowRequestThreshold.name"
            description="%slowRequestThreshold.desc"
            required="false" type="String" ibm:type="duration(ms)"/>

        <AD id="hungRequestThreshold" name="%hungRequestThreshold.name"
            description="%hungRequestThreshold.desc"
            required="false" type="String" ibm:type="duration(ms)"/>

        <AD id="enableThreadDumps" name="%enableThreadDumps.name"
            description="%enableThreadDumps.desc"
            required="false" type="Boolean" default="true"/>

        <AD id="interruptHungRequests" name="%interruptHungRequests.name"
            description="%interruptHungRequests.desc"
            required="false" type="Boolean" default="false"/>

    </OCD>

    <Designate factoryPid="com.ibm.ws.request.timing.ejb.metatype">
        <Object ocdref="com.ibm.ws.request.timing.ejb.metatype"/>
    </Designate>

</metatype:MetaData>
