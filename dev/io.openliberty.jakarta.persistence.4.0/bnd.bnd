-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0
publish.wlp.jar.suffix: dev/api/spec


Bundle-SymbolicName: io.openliberty.jakarta.persistence.4.0; singleton:=true

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

Import-Package: \
  org.osgi.framework;version="[1.6,2)", \
  org.osgi.util.tracker;version="[1.5,2)", \
  javax.sql; resolution:=optional

Export-Package: jakarta.persistence.*; jpa=4.0; version="4.0.0"; -split-package:=first

-includeresource: \
  @\${repo;jakarta.persistence:jakarta.persistence-api;4.0.0.M2;EXACT}!/!(META-INF/maven/*|module-info.class)

-maven-dependencies: \
  dep1;groupId=jakarta.persistence;artifactId=jakarta.persistence-api;version=4.0.0.M2;scope=runtime