<server description="Server for testing multiple health checks with the default Readiness overall status MP Config property enabled">

    <include location="../fatTestPorts.xml"/>

    <featureManager>
        <feature>osgiConsole-1.0</feature>
        <feature>localConnector-1.0</feature>
        <feature>appSecurity-2.0</feature>
        <feature>mpHealth-3.1</feature>
        <feature>mpConfig-2.0</feature>
        <feature>jsonp-1.1</feature>
    </featureManager>
	
 <logging traceSpecification="*=info=enabled:ChannelFramework=all:ChannelFrameworkService=all:HTTPChannel=all:TCPChannel=all:com.ibm.ws.http.internal*=all:com.ibm.ws.transport.http*=all:io.openliberty.netty*=all:com.ibm.ws.channelfw*=all" maxFileSize="50" maxFiles="20" traceFormat="BASIC"/>

    <application location="DelayedHealthCheckApp.war"/>
    <webContainer deferServletLoad="false"/> 
	
</server>
