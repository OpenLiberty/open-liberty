<server description="Test that a specific-host endpoint cannot bind a port already bound by a wildcard endpoint.">

    <include location="../fatTestCommon.xml"/>

    <featureManager>
        <feature>servlet-3.1</feature>
    </featureManager>

    <!--
        Binds the wildcard address on the port first. The test then adds HttpEndpoint2 (same ports,
        specific host) with a configuration update so HttpEndpoint1 is guaranteed to bind first.
    -->
    <httpEndpoint id="HttpEndpoint1"
                  host="*"
                  enabled="true"
                  httpPort="${bvt.prop.HTTP_default}"
                  httpsPort="${bvt.prop.HTTP_default.secure}" />

</server>
