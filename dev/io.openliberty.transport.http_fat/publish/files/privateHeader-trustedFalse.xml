<server description="Private header filter FAT — webContainer trusted=false, all private headers stripped">

    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>timedexit-1.0</feature>
    </featureManager>

    <!--
        trusted="false" on webContainer: overrides all trustedHeaderOrigin settings.
        All WAS private headers ($WSSN, $WSSP, $WSRA, etc.) are stripped regardless
        of the peer address. SERVER_NAME must reflect the Host header only.
    -->
    <webContainer trusted="false"/>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${bvt.prop.HTTP_default}"
                  httpsPort="${bvt.prop.HTTP_default.secure}">
        <tcpOptions portOpenRetries="60"/>
    </httpEndpoint>

    <application location="privateHeaderApp.war" />

</server>
