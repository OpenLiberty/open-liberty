<server description="Private header filter FAT — allowedServerNames set, no trustedSensitiveHeaderOrigin">

    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>timedexit-1.0</feature>
    </featureManager>

    <!--
        allowedServerNames: only these names (and wildcard matches) are approved to be
        returned as the API server name from $WSSN without triggering Cache-Control no-store.
        trustedSensitiveHeaderOrigin is not set (defaults to "none").
        trustedHeaderOrigin defaults to "*" so $WSSN is accepted from all peers.
    -->
    <httpDispatcher allowedServerNames="testServerName, *.example.test" />

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${bvt.prop.HTTP_default}"
                  httpsPort="${bvt.prop.HTTP_default.secure}">
        <tcpOptions portOpenRetries="60"/>
    </httpEndpoint>

    <application location="privateHeaderApp.war" />

</server>
