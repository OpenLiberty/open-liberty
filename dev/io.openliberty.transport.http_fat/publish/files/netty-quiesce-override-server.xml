<server description="Test Netty Quiesce Override" quiesceTimeout="1m30s">

    <include location="../fatTestCommon.xml"/>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${bvt.prop.HTTP_default}"
                  httpsPort="${bvt.prop.HTTP_default.secure}">
        <tcpOptions portOpenRetries="60"/>
    </httpEndpoint>

    <!-- Configure channel framework with chainQuiesceTimeout - should be overridden by server quiesceTimeout -->
    <channelfw chainQuiesceTimeout="10s"/>

    <featureManager>
        <feature>servlet-3.1</feature>
    </featureManager>

</server>
