<server description="Private header filter FAT — allowedServerNames and trustedSensitiveHeaderOrigin both set">

    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>timedexit-1.0</feature>
    </featureManager>

    <!--
        Both allowedServerNames and trustedSensitiveHeaderOrigin="*" are set.
        A $WSSN value that matches allowedServerNames AND comes from a sensitive-trusted peer
        is approved via the isWssnApproved() sensitive-trusted path.
        No Cache-Control no-store is added.
    -->
    <httpDispatcher allowedServerNames="listed.example.test"
                    trustedSensitiveHeaderOrigin="*"
                    trustedHeaderOrigin="*" />

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${bvt.prop.HTTP_default}"
                  httpsPort="${bvt.prop.HTTP_default.secure}">
        <tcpOptions portOpenRetries="60"/>
    </httpEndpoint>

    <application location="privateHeaderApp.war" />

</server>
