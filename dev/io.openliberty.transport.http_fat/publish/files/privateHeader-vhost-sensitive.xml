<server description="Private header FAT — vhost routing via trustedSensitiveHeaderOrigin">

    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>timedexit-1.0</feature>
    </featureManager>

    <!--
        trustedSensitiveHeaderOrigin="*": all peers are trusted for sensitive headers.
        $WSSN is approved via the sensitive-trusted path (no allowedServerNames needed).
        The routing key becomes public.example.test:<port>, matching publicVhost.
        No Cache-Control: no-store because the name is approved.
    -->
    <httpDispatcher trustedSensitiveHeaderOrigin="*" trustedHeaderOrigin="*" />

    <virtualHost id="publicVhost">
        <hostAlias>public.example.test:${bvt.prop.HTTP_default}</hostAlias>
    </virtualHost>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${bvt.prop.HTTP_default}"
                  httpsPort="${bvt.prop.HTTP_default.secure}">
        <tcpOptions portOpenRetries="60"/>
    </httpEndpoint>

    <application location="privateHeaderApp.war" />
    <application location="vhostApp.war" />

</server>
