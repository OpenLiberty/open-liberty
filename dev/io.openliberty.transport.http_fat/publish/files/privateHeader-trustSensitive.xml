<server description="Private header filter FAT — sensitive headers trusted from all origins">

    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>timedexit-1.0</feature>
    </featureManager>

    <!--
        trustedSensitiveHeaderOrigin="*": all sources are trusted to send sensitive
        $WS* headers such as $WSRA and $WSSP.  Used to verify that the filter
        correctly honours those headers when the trust config explicitly allows them.
    -->
    <httpDispatcher trustedHeaderOrigin="*" trustedSensitiveHeaderOrigin="*"/>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${bvt.prop.HTTP_default}"
                  httpsPort="${bvt.prop.HTTP_default.secure}">
        <tcpOptions portOpenRetries="60"/>
    </httpEndpoint>

    <application location="privateHeaderApp.war" />

</server>
