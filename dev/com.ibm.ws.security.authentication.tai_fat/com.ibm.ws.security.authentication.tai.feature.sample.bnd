-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: WebSphere TAI feature Test
Bundle-SymbolicName: com.ibm.ws.security.authentication.tai.feature.sample
Bundle-Description: WebSphere TAI feature, version ${bVersion}. 

Private-Package: \
  com.ibm.ws.security.authentication.tai.feature.sample

Include-Resource: \
  OSGI-INF=test-bundles/com.ibm.ws.security.authentication.tai.feature.sample/resources/OSGI-INF

Service-Component: \
  com.ibm.ws.security.authentication.tai.feature.sample; \
    implementation:=com.ibm.ws.security.authentication.tai.feature.sample.CustomTAI; \
    provide:=com.ibm.wsspi.security.tai.TrustAssociationInterceptor; \
    configuration-policy:=require; \
    modified:='modified'; \
    activate:='activate'; \
    deactivate:='deactivate'; \
    immediate:=true; \
    configurationAdmin=org.osgi.service.cm.ConfigurationAdmin; \
    dynamic:='configurationAdmin'; \
    properties:="service.vendor=IBM,service.ranking:Integer=888,invokeBeforeSSO:Boolean=true,disableLtpaCookie:Boolean=true"

instrument.disabled: true
