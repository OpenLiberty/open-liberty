    fat/src,\
    test-applications/AuditSessionApp/src

fat.project: true

javac.source: 11
javac.target: 11

fat.minimum.java.level: 11

-buildpath: \
    com.ibm.ws.componenttest.2.0,\
    io.openliberty.jakarta.restfulWS.3.1;version=latest,\
    io.openliberty.jakarta.servlet.6.0;version=latest
