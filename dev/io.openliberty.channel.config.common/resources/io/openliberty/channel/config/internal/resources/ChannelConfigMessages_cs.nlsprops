#COMPONENTPREFIX CWWKO
#COMPONENTNAMEFOR CWWKO WebSphere kernel channel framework service: channel configuration
#CMVCPATHNAME io.openliberty.channel.config.common/resources/io/openliberty/channel/config/internal/resources/ChannelConfigMessages.nlsprops
