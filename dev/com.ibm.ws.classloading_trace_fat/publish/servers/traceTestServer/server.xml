<?xml version="1.0" encoding="UTF-8"?>
<server>
    <include location="../fatTestPorts.xml"/>

    <featureManager>
        <feature>servlet-4.0</feature>
        <feature>componenttest-1.0</feature>
        <feature>ejb-3.2</feature>
        <feature>jca-1.7</feature>
    </featureManager>

    <!-- ClassLoadingService=all for CLASS LOAD/FAIL trace; SharedLibrary=all for publishGeneration() trace -->
    <logging traceSpecification="*=info:ClassLoadingService=all:SharedLibrary=all"
             traceFormat="BASIC"
             maxFileSize="100"
             maxFiles="10"/>

    <!-- No <fileset> child: publishGeneration() fires immediately on startup -->
    <library id="testSharedLibrary"/>

    <enterpriseApplication id="traceTestEar"
                          location="traceTestEar.ear"
                          name="traceTestEar">
        <classloader commonLibraryRef="testSharedLibrary"/>
    </enterpriseApplication>

</server>
