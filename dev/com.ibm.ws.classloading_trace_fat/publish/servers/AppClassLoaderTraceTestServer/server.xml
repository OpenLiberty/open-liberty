<?xml version="1.0" encoding="UTF-8"?>
<server>
    <include location="../fatTestPorts.xml"/>

    <featureManager>
        <feature>servlet-4.0</feature>
        <feature>componenttest-1.0</feature>
        <feature>ejb-3.2</feature>
        <feature>jca-1.7</feature>
    </featureManager>

    <!--
        testLib3.jar is placed in ${server.config.dir}/lib by the FAT setUp and wired
        as a commonLibraryRef. It is NOT bundled inside the EAR, so lib3.properties is
        absent from the EAR's own lib/ classpath. Any lookup for lib3.properties therefore
        falls through to findResourceCommonLibraryClassLoaders(afterApp) in
        AppClassLoader.findResourceInternal, emitting the "by common library loader" trace.
    -->
    <library id="testLib3">
        <fileset dir="${server.config.dir}/lib" includes="testLib3.jar"/>
    </library>

    <!-- Test EAR application with multiple modules -->
    <enterpriseApplication id="traceTestEar"
                          location="traceTestEar.ear"
                          name="traceTestEar">
        <classloader commonLibraryRef="testLib3"/>
    </enterpriseApplication>

</server>
