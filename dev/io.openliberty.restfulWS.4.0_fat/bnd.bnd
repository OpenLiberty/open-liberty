-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

src: \
    fat/src,\
    test-applications/rest40examples/src

fat.project: true

tested.features: \
    restfulws-4.0,\
    restfulwsclient-4.0,\
    jsonb-3.0,\
    jsonp-2.1,\
    servlet-6.1,\
    componenttest-2.0

-buildpath: \
    io.openliberty.jakarta.restfulWS.4.0;version=latest,\
    io.openliberty.jakarta.jsonb.3.0;version=latest,\
    io.openliberty.jakarta.jsonp.2.1;version=latest,\
    io.openliberty.jakarta.servlet.6.1;version=latest,\
    io.openliberty.jakarta.annotation.3.0;version=latest,\
    com.ibm.websphere.javaee.jaxrs.2.1;version=latest,\
    com.ibm.ws.componenttest.2.0;version=latest
