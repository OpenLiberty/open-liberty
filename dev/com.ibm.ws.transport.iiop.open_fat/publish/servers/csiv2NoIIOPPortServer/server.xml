<server>
    <include location="../fatTestCommon.xml"/>
    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>concurrent-1.0</feature>
        <feature>test.iiop-1.0</feature>
        <feature>test.user.feature-1.0</feature>
        <feature>componentTest-1.0</feature>
        <feature>ejbRemote-3.2</feature>
        <feature>appSecurity-2.0</feature>
    </featureManager>
    <!-- Use secondary HTTP port to avoid collision with csiv2SslOnlyClient (which uses HTTP_default=8010) -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${bvt.prop.HTTP_secondary}"
                  httpsPort="${bvt.prop.HTTP_secondary.secure}"/>
    <tcpOptions id="defaultTCPOptions" portOpenRetries="60"/>
    <!--
        No iiopPort attribute: it defaults to -1, which disables plain unencrypted IIOP entirely.
        iiopsPort      enables SSL-only IIOP; CSIv2SubsystemFactory opens only this
                       socket and suppresses plain IOR profiles so plain clients cannot
                       reach the EJB.
    -->
    <iiopEndpoint id="defaultIiopEndpoint">
        <iiopsOptions iiopsPort="${bvt.prop.IIOP.secondary.secure}" sslRef="defaultSSLConfig"/>
    </iiopEndpoint>
    <quickStartSecurity userName="Bob" userPassword="bobpwd"/>
    <ssl id="defaultSSLConfig" keyStoreRef="defaultKeyStore" clientAuthenticationSupported="true"/>
    <keyStore id="defaultKeyStore" password="{xor}EzY9Oi0rJg==" /> <!-- pwd: Liberty, expires1/4/2099 -->  <!-- HashiCorpIgnore -->
    <orb id="defaultOrb" orbSSLInitTimeout="60">
        <serverPolicy.csiv2>
            <layers>
                <authenticationLayer establishTrustInClient="Supported" mechanisms="GSSUP"/>
                <transportLayer sslRef="defaultSSLConfig"/>
            </layers>
        </serverPolicy.csiv2>
        <clientPolicy.csiv2>
            <layers>
                <authenticationLayer establishTrustInClient="Supported" mechanisms="GSSUP"/>
                <transportLayer sslRef="defaultSSLConfig"/>
            </layers>
        </clientPolicy.csiv2>
    </orb>
</server>
