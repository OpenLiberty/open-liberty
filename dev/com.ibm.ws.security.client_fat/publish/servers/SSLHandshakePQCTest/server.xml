<server>
<include location="../fatTestPorts.xml" />
	<include location="server_base.xml" />

	<!-- Server is configured with TLS 1.3 and PQC enabled.
	     JVM arg -Djdk.tls.namedGroups=X25519MLKEM768,X25519,secp256r1,secp384r1 is set in jvm.options.
	     This server is dedicated to PQC handshake tests where both client and server support PQC. -->
	<ssl id="supportedClientAuthenticationSSLConfig"
		clientAuthenticationSupported="true"
		keyStoreRef="defaultKeyStore"
		sslProtocol="TLSv1.3" />

</server>
