<server>
<include location="../fatTestPorts.xml" />
	<include location="server_base.xml" />

	<!-- Server is configured with TLS 1.3 and PQC named groups only (no classical fallback).
	     Used to verify that a non-PQC client cannot negotiate a connection when the server
	     exclusively offers X25519MLKEM768 and has no classical group to fall back to. -->
	<ssl id="supportedClientAuthenticationSSLConfig"
		clientAuthenticationSupported="true"
		keyStoreRef="defaultKeyStore"
		sslProtocol="TLSv1.3"
		namedGroups="X25519MLKEM768" />

</server>
