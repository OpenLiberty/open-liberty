<server>
<include location="../fatTestPorts.xml" />
	<include location="server_base.xml" />

<!-- Server is configured with TLS 1.3 and NO explicit named group configuration.
     No namedGroups attribute is set here, causing the server to fall back to the JDK built-in
     default named groups. Used to verify that a PQC-only client can still negotiate
     X25519MLKEM768 via the JDK default when the server has no named group config at all. -->
	<ssl id="supportedClientAuthenticationSSLConfig"
		clientAuthenticationSupported="true"
		keyStoreRef="defaultKeyStore"
		sslProtocol="TLSv1.3" />

</server>
