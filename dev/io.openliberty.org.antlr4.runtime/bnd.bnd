-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-SymbolicName: io.openliberty.org.antlr4.runtime; singleton:=true
Bundle-Description: ANTLR 4 Runtime, version 4.13.2

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"

-includeresource: \
  @${repo;org.antlr:antlr4-runtime;4.13.2;EXACT}!/!module-info.class

instrument.disabled: true

-buildpath: \
        org.antlr:antlr4-runtime;version=4.13.2, \
        com.ibm.ws.org.osgi.annotation.versioning;version=latest
