-include= ~../cnf/resources/bnd/bundle.props

bVersion=1.0

Bundle-Name: Liberty Security REST JWT TAI
Bundle-SymbolicName: io.openliberty.security.rest.jwt
Bundle-Description: WebSphere Security REST Admin JWT Trust Association Interceptor, version=${bVersion}

WS-TraceGroup: \
  RESTJWT

IBM-Default-Config: OSGI-INF/wlp/defaultInstances.xml

Export-Package: \
   io.openliberty.security.rest.jwt.tai

Import-Package: \
   javax.servlet;version="!", \
   javax.servlet.*;version="!", \
   com.ibm.websphere.security.jwt;version="[1.0,11)", \
   com.ibm.wsspi.security.tai;version="[1.1,11)", \
   com.ibm.ws.security.authentication.filter;version="[1.0,11)", \
   *

Private-Package: \
   io.openliberty.security.rest.jwt.tai.*

Include-Resource: \
   OSGI-INF=resources/OSGI-INF

-dsannotations: \
   io.openliberty.security.rest.jwt.tai.RestJwtTAI

-dsannotations-inherit = true

-buildpath: \
	com.ibm.websphere.org.osgi.core;version=latest, \
	com.ibm.websphere.org.osgi.service.component;version=latest, \
	com.ibm.wsspi.org.osgi.service.component.annotations;version=latest, \
	com.ibm.ws.org.osgi.annotation.versioning;version=latest, \
	com.ibm.ws.logging;version=latest, \
	com.ibm.ws.kernel.service;version=latest, \
	com.ibm.websphere.security;version=latest, \
	com.ibm.ws.security;version=latest, \
	com.ibm.ws.security.registry;version=latest, \
	com.ibm.ws.security.authentication.tai;version=latest, \
	com.ibm.ws.security.authentication;version=latest, \
	com.ibm.ws.security.authentication.filter;version=latest, \
	com.ibm.ws.security.jwt;version=latest, \
	com.ibm.ws.security.common;version=latest, \
	com.ibm.ws.security.common.jsonwebkey;version=latest, \
	com.ibm.ws.webcontainer.security;version=latest, \
	com.ibm.websphere.javaee.servlet.3.1;version=latest, \
	com.ibm.ws.security.credentials;version=latest, \
	com.ibm.ws.security.token;version=latest

-testpath: \
	../build.sharedResources/lib/junit/old/junit.jar;version=file, \
	com.ibm.ws.junit.extensions;version=latest, \
	org.jmock:jmock-legacy;version=2.5.0, \
	cglib:cglib;version=3.3.0, \
	com.ibm.ws.org.objectweb.asm;version=latest, \
	org.hamcrest:hamcrest-all;version=1.3, \
	org.jmock:jmock-junit4;strategy=exact;version=2.5.1, \
	org.jmock:jmock;strategy=exact;version=2.5.1, \
	com.ibm.ws.org.objenesis:objenesis;version=1.0, \
	com.ibm.ws.kernel.boot;version=latest
