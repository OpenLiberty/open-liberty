-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

src: fat/src

fat.project: true

tested.features: \
  cdi-2.0, cdi-3.0, cdi-4.0, cdi-4.1,\
  expressionlanguage-4.0, expressionlanguage-5.0, expressionlanguage-6.0,\
  jaxb-2.3,\
  jaxws-2.3,\
  pages-3.0, pages-3.1, pages-4.0,\
  servlet-4.0, servlet-5.0, servlet-6.0, servlet-6.1,\
  xmlbinding-4.0,\
  xmlws-3.0, xmlws-4.0

-buildpath: \
    com.ibm.ws.transaction.fat.util,\
    com.ibm.ws.transaction.test.util;version=latest,\
    com.ibm.websphere.javaee.servlet.4.0;version=latest,\
    com.ibm.websphere.org.osgi.core,\
    com.ibm.ws.org.osgi.annotation.versioning;version=latest,\
    com.ibm.ws.wsat.common_fat;version=latest
