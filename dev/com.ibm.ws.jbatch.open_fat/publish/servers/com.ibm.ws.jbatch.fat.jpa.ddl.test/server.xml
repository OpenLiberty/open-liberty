<server>

        <include location="../fatTestPorts.xml" />

        <featureManager>
                <feature>batchManagement-1.0</feature>
                <feature>servlet-3.1</feature>
                <feature>jsonp-1.0</feature>
        </featureManager>
<!--
    <logging traceSpecification="*=info:com.ibm.ws.batch.JobLogger=finest:batch.fat.*=all:com.ibm.jbatch.container.persistence.jpa.*=all:com.ibm.jbatch.container.services.impl.MemoryPersistenceManager.impl=all:com.ibm.jbatch.container.controller.impl.BaseStepControllerImpl=all:com.ibm.jbatch.container.controller.impl.PartitionedStepControllerImpl=all" />

-->

   <keyStore id="defaultKeyStore" password="Liberty" />

	<basicRegistry id="basic" realm="ibm/api">
		<user name="bob" password="bobpwd" />
		<user name="phyllis" password="phyllispwd" />
		<user name="jane" password="janepwd" />
	</basicRegistry>

	<administrator-role>
		<user>bob</user>
		<user>phyllis</user>
	</administrator-role>
	
	<!-- Everyone is a batch admin for non security related tests -->
	<authorization-roles id="com.ibm.ws.batch">
		<security-role name="batchAdmin">
			<user name="bob" />
			<user name="phyllis" />
			<user name="jane" />
		</security-role>
	</authorization-roles>
        
        <batchPersistence jobStoreRef="BatchDatabaseStore"/>

        <databaseStore dataSourceRef="batchDB" id="BatchDatabaseStore" schema="JBATCH" tablePrefix=""/>

        <library id="H2Lib">
            <fileset dir="${shared.resource.dir}/h2Java8" includes="h2.jar"/>
        </library>

        <dataSource id="batchDB" jndiName="jdbc/batch">
          <jdbcDriver libraryRef="H2Lib"/>
              <!-- The following configures in-memory H2.  For H2 on disk, which is needed if the database
              is required beyond a single server start, configure the databaseName with a file location such as:
              databaseName="${shared.config.dir}/data/h2db" -->
              <properties.h2 URL="jdbc:h2:mem:BATCHDB2;DB_CLOSE_DELAY=-1;INIT=CREATE SCHEMA IF NOT EXISTS JBATCH;NON_KEYWORDS=VALUE" user="user" password="pass"/>
        </dataSource>
        
        <javaPermission className="java.util.PropertyPermission" name="*" actions="read"/>
        <javaPermission codebase="${shared.resource.dir}/h2Java8/h2.jar" className="java.security.AllPermission"/>
        
</server>
