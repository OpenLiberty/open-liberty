-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

src: \
	src,\
	test-applications/BeanInterfaces.jar/src,\
	test-applications/DownstreamEJB.jar/src,\
	test-applications/IntermediateEJB.jar/src,\
	test-applications/SetWSSubjectBeanEJB.jar/src,\
	test-applications/GetWSSubjectBeanWeb.war/src,\
	test-applications/csiv2Client.war/src,\
	test-applications/client.war/src

test.project: true

-buildpath: \
	com.ibm.websphere.javaee.annotation.1.1;version=latest,\
	com.ibm.websphere.javaee.ejb.3.2;version=latest,\
	com.ibm.websphere.javaee.servlet.3.0;version=latest,\
	com.ibm.websphere.security;version=latest,\
	com.ibm.ws.logging;version=latest,\
	com.ibm.ws.security.authentication;version=latest,\
	com.ibm.ws.security.csiv2.common;version=latest,\
	com.ibm.ws.security.fat.common;version=latest,\
	com.ibm.ws.security.jaas.common;version=latest,\
	com.ibm.ws.webcontainer.security_test.servlets;version=latest,\
	io.openliberty.yoko.rmi.spec;version=latest,\
	io.openliberty.yoko.spec.corba;version=latest,\
	org.apache.httpcomponents:httpclient;strategy=exact;version=4.1.2,\
	org.apache.httpcomponents:httpcore;strategy=exact;version=4.1.2
