<server>
<!-- client_certSupported_ltpaNever_noAssertion -->
    <include location="imports/upstreamIncludes_outboundSSLFilter.xml"/>

    <sslDefault sslRef="supportedClientAuthenticationSSLConfig" outboundSSLRef="outboundDefaultSSL"/>

    <orb id="defaultOrb">
        <clientPolicy.csiv2>
            <layers>
                <attributeLayer identityAssertionEnabled="false"/>
                <authenticationLayer mechanisms="LTPA" establishTrustInClient="Never"/>
                <transportLayer/>
            </layers>
        </clientPolicy.csiv2>
    </orb>

</server>
