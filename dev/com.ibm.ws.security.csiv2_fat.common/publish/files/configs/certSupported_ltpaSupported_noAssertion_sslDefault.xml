            <layers>
                <attributeLayer identityAssertionEnabled="false"/>
                <authenticationLayer mechanisms="LTPA" establishTrustInClient="Supported"/>
                <transportLayer/>
            </layers>
        </serverPolicy.csiv2>
    </orb>

</server>
