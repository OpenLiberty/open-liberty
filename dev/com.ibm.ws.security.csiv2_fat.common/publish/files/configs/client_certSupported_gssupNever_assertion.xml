<server>
<!-- client_certSupported_gssupNever_assertion -->
    <include location="imports/upstreamIncludes.xml"/>

    <orb id="defaultOrb">
        <clientPolicy.csiv2>
            <layers>
                <attributeLayer identityAssertionEnabled="true"/>
                <authenticationLayer mechanisms="GSSUP" establishTrustInClient="Never"/>
                <transportLayer sslRef="supportedClientAuthenticationSSLConfig"/>
            </layers>
        </clientPolicy.csiv2>
    </orb>

</server>
