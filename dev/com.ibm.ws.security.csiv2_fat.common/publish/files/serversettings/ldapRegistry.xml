<server>

	<ldapRegistry id="LDAP" realm="SampleLdapIDSRealm" host="${ldap.server.8.name}" port="${ldap.server.8.port}" ignoreCase="true"  
		baseDN="o=ibm,c=us"
		userFilter="(&amp;(uid=%v)(objectclass=ePerson))"
		groupFilter="(&amp;(cn=%v)(|(objectclass=groupOfNames)(objectclass=groupOfUniqueNames)))"
		userIdMap="*:uid"
		groupIdMap="*:cn"
		groupMemberIdMap="ibm-allGroups:member;ibm-allGroups:uniqueMember"
		ldapType="IBM Tivoli Directory Server"
		searchTimeout="8m">
		<failoverServers name="failoverLdapServers">
		   <server host="${ldap.server.4.name}" port="${ldap.server.4.port}"/>
       	</failoverServers>
	</ldapRegistry>	       		

</server>
