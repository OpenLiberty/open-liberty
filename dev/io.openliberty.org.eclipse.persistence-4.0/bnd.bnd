-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-SymbolicName: io.openliberty.org.eclipse.persistence-4.0
Bundle-Name: Eclipse Persistence 4.0 Wrapper
Bundle-Description: Wrapper bundle for Eclipse Persistence 4.0; version=${bVersion}

javac.source: 21
javac.target: 21

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=21))"