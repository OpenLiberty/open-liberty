<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_4_0.xsd"
             version="4.0">

    <persistence-unit name="JakartaPersistenceUnit">
        <!-- Explicit class list required: Liberty app classloader scanning is limited -->
        <class>io.openliberty.jpa.persistence.tests.models.SimpleEmployee</class>
        <class>io.openliberty.jpa.persistence.tests.models.Product</class>
        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>
        <properties>
            <!-- Drop and recreate the database schema for clean test runs -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>

            <!-- EclipseLink-specific (ignored by Hibernate) -->
            <property name="eclipselink.logging.parameters" value="true"/>

            <!-- Hibernate-specific (ignored by EclipseLink) -->
            <property name="hibernate.show_sql" value="true"/>

            <!-- ORA-43853: disable SecureFiles LOB syntax for non-ASSM tablespaces (e.g. SYSTEM) -->
            <property name="hibernate.dialect.oracle.value_lob_enabled" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
