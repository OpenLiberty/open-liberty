<server>
    <featureManager>
        <feature>persistenceContainer-4.0</feature>
        <feature>servlet-6.2</feature>
        <feature>jndi-1.0</feature>
        <feature>xmlBinding-4.0</feature>
        <feature>componenttest-2.0</feature>
    </featureManager>

    <jpa defaultPersistenceProvider="org.hibernate.jpa.HibernatePersistenceProvider"/>

    <library id="HibernateLib">
        <fileset dir="${shared.resource.dir}/jpa_fat_jpa40_persistencecontainer" includes="*.jar"/>
    </library>

</server>
