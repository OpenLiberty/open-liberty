-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-SymbolicName: io.openliberty.jakarta.concurrency.3.2; singleton:=true
Specification-Title: Jakarta Concurrency
Specification-Vendor: Eclipse Foundation
Specification-Version: 3.2

javac.source: 17
javac.target: 17

Require-Capability: osgi.ee; filter:="(&(osgi.ee=JavaSE)(version=17))"

Export-Package: \
  jakarta.enterprise.concurrent;version="3.2.0",\
  jakarta.enterprise.concurrent.spi;version="3.2.0"

DynamicImport-Package: \
  jakarta.enterprise.util,\
  jakarta.interceptor

Import-Package: \
  !jakarta.enterprise.util,\
  !jakarta.interceptor,\
  *

-includeresource: \
  @${repo;jakarta.concurrency:jakarta.concurrency-api;3.2.0.M2;EXACT}!/!(META-INF/maven/*|module-info.class)

-maven-dependencies: \
   dep1;groupId=jakarta.concurrency;artifactId=jakarta.concurrency-api;version=3.2.0-M2;scope=runtime
